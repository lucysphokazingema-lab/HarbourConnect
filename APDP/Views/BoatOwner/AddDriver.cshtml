@model APDP.Models.Driver
@{
    ViewBag.Title = "Add New Driver";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card hc-form-card">
                <div class="card-header hc-form-header">
                    <h4 class="mb-0">&#128663; Add New Driver</h4>
                </div>
                <div class="card-body p-4">

                    @using (Html.BeginForm("AddDriver", "BoatOwner", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        if (!ViewData.ModelState.IsValid)
                        {
                            @Html.ValidationSummary(true, "Please fix the errors below:", new { @class = "alert alert-danger" })
                        }

                        @* ── Driver Information ───────────────────────── *@
                        <h6 class="hc-form-section-title">Driver Information</h6>

                        <div class="row g-3 mb-2">
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "e.g. John Dlamini" })
                                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6">
                                @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "e.g. 0821234567", type = "tel" })
                                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.LicenseNumber, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.LicenseNumber, new { @class = "form-control", placeholder = "e.g. DRV-2024-001" })
                            @Html.ValidationMessageFor(m => m.LicenseNumber, "", new { @class = "text-danger small" })
                        </div>

                        @* ── Login Credentials ────────────────────────── *@
                        <h6 class="hc-form-section-title mt-3">Login Credentials</h6>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "driver@example.com", type = "email" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Password, new { @class = "form-control", type = "password", id = "driverPassword", placeholder = "Minimum 6 characters" })
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePwd()">&#128065;</button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        @* ── Boat Assignment ──────────────────────────── *@
                        <h6 class="hc-form-section-title mt-3">Boat Assignment</h6>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Assign to Boat <span class="text-muted fw-normal">(optional)</span></label>
                            @Html.DropDownList("AssignedBoatID", ViewBag.OwnerBoats as SelectList,
                                "-- No assignment yet --",
                                new { @class = "form-select" })
                            <small class="text-muted">You can change this later from Manage Drivers.</small>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success btn-lg">Add Driver</button>
                            @Html.ActionLink("Cancel", "ManageDrivers", "BoatOwner", null, new { @class = "btn btn-outline-secondary btn-lg" })
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        function togglePwd() {
            var f = document.getElementById('driverPassword');
            f.type = (f.type === 'password') ? 'text' : 'password';
        }
    </script>
}
