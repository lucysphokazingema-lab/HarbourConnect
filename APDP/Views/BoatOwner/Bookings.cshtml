@model IEnumerable<APDP.Models.Booking>
@{
    ViewBag.Title = "My Boat Bookings";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>&#128203; Bookings for My Boats</h2>
        @Html.ActionLink("Back to Dashboard", "Dashboard", "BoatOwner", null, new { @class = "btn btn-outline-secondary" })
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h5>No bookings yet.</h5>
            <p>Once customers book your boats, their bookings will appear here.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover hc-table align-middle">
                <thead>
                    <tr>
                        <th>Booking #</th>
                        <th>Customer</th>
                        <th>Boat</th>
                        <th>Trip Date</th>
                        <th>Passengers</th>
                        <th>Total (R)</th>
                        <th>Status</th>
                        <th>Booked On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>#@booking.BookingID</td>
                            <td>@booking.Customer.FullName</td>
                            <td>@booking.Boat.BoatName</td>
                            <td>@booking.TripDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @booking.NumberOfPassengers adult@(booking.NumberOfPassengers == 1 ? "" : "s")
                                @if (booking.ChildPassengers > 0)
                                {
                                    <text>, @booking.ChildPassengers child@(booking.ChildPassengers == 1 ? "" : "ren")</text>
                                }
                            </td>
                            <td>R @booking.TotalPrice.ToString("N2")</td>
                            <td>
                                @switch (booking.Status)
                                {
                                    case APDP.Models.BookingStatus.Confirmed:
                                        <span class="badge bg-success">Confirmed</span>
                                        break;
                                    case APDP.Models.BookingStatus.Cancelled:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                    case APDP.Models.BookingStatus.Completed:
                                        <span class="badge bg-secondary">Completed</span>
                                        break;
                                    default:
                                        <span class="badge bg-warning text-dark">Pending</span>
                                        break;
                                }
                            </td>
                            <td>@booking.BookingDate.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
