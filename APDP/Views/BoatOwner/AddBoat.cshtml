        /* ── Document cards ─────────────────────────────────────── */
        .hc-doc-card  { border:2px solid #dee2e6; border-radius:10px; padding:14px; background:#fafafa; height:100%; }
        .hc-doc-icon  { font-size:1.8rem; margin-bottom:4px; }
