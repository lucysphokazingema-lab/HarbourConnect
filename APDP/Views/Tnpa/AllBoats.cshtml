@model IEnumerable<APDP.Models.Boat>
@{
    ViewBag.Title = "All Registered Boats";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>&#128674; All Registered Boats</h2>
        @Html.ActionLink("Back to Dashboard", "Dashboard", "Tnpa", null, new { @class = "btn btn-outline-secondary" })
    </div>

    <div class="table-responsive">
        <table class="table table-hover hc-table align-middle">
            <thead>
                <tr>
                    <th>Boat Name</th>
                    <th>Type</th>
                    <th>Registration</th>
                    <th>Location</th>
                    <th>Owner</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var boat in Model)
                {
                    <tr>
                        <td class="fw-semibold">@boat.BoatName</td>
                        <td>@boat.BoatType</td>
                        <td>@boat.RegistrationNumber</td>
                        <td>@boat.HarbourLocation</td>
                        <td>@boat.BoatOwner.FullName</td>
                        <td>R @boat.PricePerTrip.ToString("N2")</td>
                        <td>
                            @if (boat.Status == APDP.Models.BoatStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (boat.Status == APDP.Models.BoatStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>
                            @Html.ActionLink("Details", "BoatDetails", "Tnpa", new { id = boat.BoatID }, new { @class = "btn btn-sm btn-outline-primary" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
