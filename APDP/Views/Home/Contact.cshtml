@{
    ViewBag.Title = "Contact Us";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <h2 class="hc-section-title">Contact Us</h2>
            <p class="lead text-muted">@ViewBag.Message</p>
            <hr />

            <div class="row g-4 mt-2">
                <div class="col-md-6">
                    <div class="card hc-card p-4">
                        <h5>&#128205; Head Office</h5>
                        <address class="mt-3 text-muted">
                            HarbourConnect Head Office<br />
                            Transnet National Ports Authority<br />
                            Durban Harbour, KwaZulu-Natal<br />
                            South Africa, 4001
                        </address>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card hc-card p-4">
                        <h5>&#128222; Contact Details</h5>
                        <ul class="list-unstyled mt-3 text-muted">
                            <li><strong>General Enquiries:</strong><br />
                                <a href="mailto:info@harbourconnect.co.za">info@harbourconnect.co.za</a>
                            </li>
                            <li class="mt-2"><strong>Boat Owner Support:</strong><br />
                                <a href="mailto:owners@harbourconnect.co.za">owners@harbourconnect.co.za</a>
                            </li>
                            <li class="mt-2"><strong>Customer Support:</strong><br />
                                <a href="mailto:support@harbourconnect.co.za">support@harbourconnect.co.za</a>
                            </li>
                            <li class="mt-2"><strong>Phone:</strong><br />
                                +27 31 555 0100
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                @Html.ActionLink("Back to Home", "Index", "Home", null, new { @class = "btn btn-primary" })
            </div>
        </div>
    </div>
</div>
