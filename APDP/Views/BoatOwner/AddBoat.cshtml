@model APDP.Models.Boat
@{
    ViewBag.Title = "Add New Boat";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9">

            <div class="card hc-form-card">
                <div class="card-header hc-form-header">
                    <h4 class="mb-0">&#128674; Register a New Boat</h4>
                </div>
                <div class="card-body p-4">

                    @using (Html.BeginForm("AddBoat", "BoatOwner", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.HarbourLocation, new { Value = "Durban Harbour" })

                        if (!ViewData.ModelState.IsValid)
                        {
                            @Html.ValidationSummary(true, "Please fix the errors below:", new { @class = "alert alert-danger" })
                        }

                        @* ── 1. Boat Details ─────────────────────────────────── *@
                        <h6 class="hc-form-section-title">1. Boat Details</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.BoatName, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.BoatName, new { @class = "form-control", placeholder = "e.g. Sea Breeze" })
                                @Html.ValidationMessageFor(m => m.BoatName, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.RegistrationNumber, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.RegistrationNumber, new { @class = "form-control", placeholder = "e.g. SA-DBN-1234", maxlength = "50" })
                                @Html.ValidationMessageFor(m => m.RegistrationNumber, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.BoatType, new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(m => m.BoatType,
                                    new SelectList(new[] { "Fishing Boat", "Leisure Cruiser", "Speed Boat", "Yacht", "Catamaran", "Party Boat", "Other" }),
                                    "-- Select Type --",
                                    new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.BoatType, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
                            @Html.TextAreaFor(m => m.Description, 3, 0, new { @class = "form-control", placeholder = "Describe your boat and what it offers..." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        @* ── 2. Capacity & Pricing ───────────────────────────── *@
                        <h6 class="hc-form-section-title mt-4">2. Capacity &amp; Pricing</h6>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.MaxPassengers, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.MaxPassengers, new { @class = "form-control", type = "number", min = "1", max = "200" })
                                @Html.ValidationMessageFor(m => m.MaxPassengers, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-semibold">Hourly Pricing</label>
                                <p class="text-muted small mb-2">Set the rate per person per hour. Total = passengers &times; rate &times; hours booked.</p>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label class="form-label small mb-1">Adult (16+)</label>
                                        <div class="input-group">
                                            <span class="input-group-text fw-bold">R</span>
                                            @Html.TextBoxFor(m => m.PriceAdult, new { @class = "form-control", type = "number", min = "0", step = "any", placeholder = "e.g. 200" })
                                            <span class="input-group-text text-muted">/hr</span>
                                        </div>
                                        @Html.ValidationMessageFor(m => m.PriceAdult, "", new { @class = "text-danger small" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small mb-1">Child (2–15)</label>
                                        <div class="input-group">
                                            <span class="input-group-text fw-bold">R</span>
                                            @Html.TextBoxFor(m => m.PriceChild, new { @class = "form-control", type = "number", min = "0", step = "any", placeholder = "e.g. 150" })
                                            <span class="input-group-text text-muted">/hr</span>
                                        </div>
                                        @Html.ValidationMessageFor(m => m.PriceChild, "", new { @class = "text-danger small" })
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-md-10">
                                <label class="form-label fw-semibold">Trip Duration Options</label>
                                <p class="text-muted small mb-3">
                                    Set the <strong>minimum</strong> and <strong>maximum</strong> hours a customer may book.
                                    Customers will only see duration choices between these two values.
                                </p>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Minimum hours <span class="text-muted fw-normal">(shortest trip)</span></label>
                                        <div class="d-flex flex-wrap gap-2" id="minDurGroup">
                                            @foreach (var opt in new[] {
                                                new { Val = 60,  Label = "1 hr" },
                                                new { Val = 120, Label = "2 hrs" },
                                                new { Val = 180, Label = "3 hrs" },
                                                new { Val = 240, Label = "4 hrs" }
                                            })
                                            {
                                                <label class="hc-slot-btn" style="cursor:pointer;">
                                                    @Html.RadioButtonFor(m => m.DefaultTripDurationMinutes, opt.Val,
                                                        new { @class = "hc-slot-radio", id = "minDur_" + opt.Val, onchange = "validateDurationRange()" })
                                                    @opt.Label
                                                </label>
                                            }
                                        </div>
                                        @Html.ValidationMessageFor(m => m.DefaultTripDurationMinutes, "", new { @class = "text-danger small d-block mt-1" })
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold small">Maximum hours <span class="text-muted fw-normal">(longest trip — optional)</span></label>
                                        <div class="d-flex flex-wrap gap-2" id="maxDurGroup">
                                            @* 0 = no limit *@
                                            <label class="hc-slot-btn" style="cursor:pointer;">
                                                @Html.RadioButtonFor(m => m.MaxBookingHours, 0,
                                                    new { @class = "hc-slot-radio", id = "maxDur_0", onchange = "validateDurationRange()", @checked = "checked" })
                                                No limit
                                            </label>
                                            @foreach (var opt in new[] {
                                                new { Val = 1, Label = "1 hr" },
                                                new { Val = 2, Label = "2 hrs" },
                                                new { Val = 3, Label = "3 hrs" },
                                                new { Val = 4, Label = "4 hrs" },
                                                new { Val = 6, Label = "6 hrs" },
                                                new { Val = 8, Label = "8 hrs" }
                                            })
                                            {
                                                <label class="hc-slot-btn" style="cursor:pointer;">
                                                    @Html.RadioButtonFor(m => m.MaxBookingHours, opt.Val,
                                                        new { @class = "hc-slot-radio", id = "maxDur_" + opt.Val, onchange = "validateDurationRange()" })
                                                    @opt.Label
                                                </label>
                                            }
                                        </div>
                                        @Html.ValidationMessageFor(m => m.MaxBookingHours, "", new { @class = "text-danger small d-block mt-1" })
                                        <div id="durationRangeError" class="text-danger small mt-1" style="display:none;">
                                            Maximum must be equal to or greater than minimum.
                                        </div>
                                    </div>
                                </div>
                                <div class="alert alert-light border mt-3 py-2 small" id="durationPreview">
                                    Customers will be able to choose: <strong id="durationPreviewText">&mdash;</strong>
                                </div>
                            </div>
                        </div>

                        @* ── Weekly Timetable ─────────────────────────────────── *@
                        @Html.Partial("_WeeklyTimetable", (List<APDP.Helpers.DayHours>)ViewBag.Week,
                            new ViewDataDictionary { { "BufferMinutes", Model != null ? Model.BufferMinutes : 0 } })

                        @* ── 3. Required Documents ───────────────────────────── *@
                        <h6 class="hc-form-section-title mt-4">3. Required Documents</h6>
                        <p class="text-muted small mb-3">TNPA requires official documents for approval. Upload a PDF or scanned image of each.</p>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <div class="hc-doc-card">
                                    <div class="hc-doc-icon">&#128100;</div>
                                    <div class="hc-doc-title">Owner ID Document</div>
                                    <div class="hc-doc-desc text-muted small mb-2">SA ID or passport scan.</div>
                                    <input type="file" name="docOwnerId" class="form-control form-control-sm"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           onchange="markDoc(this,'docOwnerIdStatus')" />
                                    <div id="docOwnerIdStatus" class="mt-1"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="hc-doc-card">
                                    <div class="hc-doc-icon">&#128220;</div>
                                    <div class="hc-doc-title">Boat Registration Certificate</div>
                                    <div class="hc-doc-desc text-muted small mb-2">SAMSA or TNPA certificate.</div>
                                    <input type="file" name="docRegCert" class="form-control form-control-sm"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           onchange="markDoc(this,'docRegCertStatus')" />
                                    <div id="docRegCertStatus" class="mt-1"></div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="hc-doc-card">
                                    <div class="hc-doc-icon">&#128195;</div>
                                    <div class="hc-doc-title">Boat / Operating Licence</div>
                                    <div class="hc-doc-desc text-muted small mb-2">Valid boat operating licence.</div>
                                    <input type="file" name="docLicence" class="form-control form-control-sm"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           onchange="markDoc(this,'docLicenceStatus')" />
                                    <div id="docLicenceStatus" class="mt-1"></div>
                                </div>
                            </div>
                        </div>

                        @* ── 4. Safety Equipment - checkboxes only ───────────── *@
                        <h6 class="hc-form-section-title mt-4">4. Safety Equipment</h6>
                        <p class="text-muted small mb-3">Tick every safety item that is on board your boat.</p>

                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="hc-check-tile hc-check-tile-required">
                                    @Html.CheckBoxFor(m => m.HasLifeJackets, new { @class = "hc-tile-cb", id = "HasLifeJackets" })
                                    <span class="hc-tile-body">
                                        <span class="hc-tile-icon">&#129399;</span>
                                        <span class="hc-tile-name">Life Jackets <span class="badge bg-danger ms-1" style="font-size:0.6rem;">Required</span></span>
                                    </span>
                                </label>
                                @Html.ValidationMessageFor(m => m.HasLifeJackets, "", new { @class = "text-danger small d-block" })
                            </div>
                            <div class="col-md-4">
                                <label class="hc-check-tile">
                                    @Html.CheckBoxFor(m => m.HasMedKit, new { @class = "hc-tile-cb", id = "HasMedKit" })
                                    <span class="hc-tile-body">
                                        <span class="hc-tile-icon">&#129657;</span>
                                        <span class="hc-tile-name">Medical Kit</span>
                                    </span>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="hc-check-tile">
                                    @Html.CheckBoxFor(m => m.HasFireExtinguisher, new { @class = "hc-tile-cb", id = "HasFireExtinguisher" })
                                    <span class="hc-tile-body">
                                        <span class="hc-tile-icon">&#128293;</span>
                                        <span class="hc-tile-name">Fire Extinguisher</span>
                                    </span>
                                </label>
                            </div>
                        </div>

                        @* ── 5. Paid Extras (add-ons customers can select at booking) ─── *@
                        <h6 class="hc-form-section-title mt-4">5. Paid Extras <span class="text-muted fw-normal fs-6">(optional)</span></h6>
                        <p class="text-muted small mb-2">Optional items customers can add at booking, each with a name and price.</p>

                        <div id="extrasContainer">
                            @* Rows are added dynamically by JS *@
                        </div>

                        <button type="button" class="btn btn-outline-primary btn-sm mt-2" onclick="addExtraRow()">
                            + Add an Extra
                        </button>

                        @* ── 6. Disability Accommodation ─────────────────────── *@
                        <h6 class="hc-form-section-title mt-4">6. Disability Accommodation <span class="text-muted fw-normal fs-6">(optional)</span></h6>

                        <div class="mb-3">
                            <label class="hc-check-tile" style="max-width:480px;">
                                @Html.CheckBoxFor(m => m.IsDisabilityFriendly, new
                                {
                                    @class  = "hc-tile-cb",
                                    id      = "IsDisabilityFriendly",
                                    onchange = "toggleDisabilityDetails(this)"
                                })
                                <span class="hc-tile-body">
                                    <span class="hc-tile-icon">&#9855;</span>
                                    <span class="hc-tile-name">This boat accommodates people with disabilities</span>
                                </span>
                            </label>

                            <div id="disabilityDetails" style="display:none;" class="mt-3">
                                <label class="form-label fw-semibold small">Describe the accessibility features</label>
                                @Html.TextAreaFor(m => m.DisabilityAccommodation, 3, 0, new
                                {
                                    @class      = "form-control",
                                    placeholder = "e.g. wheelchair ramp, wide boarding platform, accessible seating"
                                })
                                @Html.ValidationMessageFor(m => m.DisabilityAccommodation, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        @* ── 7. Boat Media (Photos & Videos) ──────────────────── *@
                        <h6 class="hc-form-section-title mt-4">7. Boat Photos &amp; Videos</h6>
                        <p class="text-muted small mb-3">
                            Upload photos and videos of your boat — shown to customers and TNPA reviewers.
                            More media makes a stronger application.
                        </p>

                        @* ── Photos ─────────────────────────────────────────── *@
                        <p class="text-muted small mb-2">
                            &#128247; <strong>Photos</strong> — JPG, PNG, WEBP &nbsp;|&nbsp; Up to 6 photos
                        </p>

                        @* Single multi-file input with name="boatPhotos" — controller reads via Request.Files.GetMultiple("boatPhotos") *@
                        <input type="file" id="photoFileInput" name="boatPhotos"
                               accept=".jpg,.jpeg,.png,.gif,.webp" multiple class="d-none" />

                        <div class="hc-upload-zone mb-2" id="photoDropZone">
                            <p class="text-muted small mb-2">Drag your photos here or click <strong>Upload photos</strong></p>
                            <button type="button" class="btn btn-primary btn-sm px-4"
                                    onclick="document.getElementById('photoFileInput').click()">
                                &#128247; Upload photos
                            </button>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mt-3" id="photoThumbGrid"></div>

                        @* ── Videos ─────────────────────────────────────────── *@
                        <p class="text-muted small mt-4 mb-2">
                            &#127909; <strong>Videos</strong> — MP4, MOV, AVI, WEBM &nbsp;|&nbsp; Up to 3 videos
                        </p>

                        @* Single multi-file input with name="boatVideos" *@
                        <input type="file" id="videoFileInput" name="boatVideos"
                               accept=".mp4,.mov,.avi,.webm" multiple class="d-none" />

                        <div class="hc-upload-zone mb-2" id="videoDropZone">
                            <p class="text-muted small mb-2">Drag your videos here or click <strong>Upload videos</strong></p>
                            <button type="button" class="btn btn-outline-primary btn-sm px-4"
                                    onclick="document.getElementById('videoFileInput').click()">
                                &#127909; Upload videos
                            </button>
                        </div>
                        <div class="d-flex flex-wrap gap-3 mt-3" id="videoThumbGrid"></div>

                        @* ── Submit ───────────────────────────────────────────── *@
                        <hr class="my-4" />
                        <div class="d-flex gap-3 align-items-center flex-wrap">
                            <button type="submit" class="btn btn-primary btn-lg fw-semibold px-5">
                                Submit for TNPA Review
                            </button>
                            @Html.ActionLink("Back to My Boats", "MyBoats", "BoatOwner", null,
                                new { @class = "btn btn-outline-secondary btn-lg" })
                        </div>
                        <p class="text-muted small mt-3 mb-0">
                            Once submitted, your boat will show as <strong>Pending</strong> on your My Boats page until a TNPA admin reviews it.
                        </p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        // ── Dynamic photo/video uploader ───────────────────────────
        var photoFiles = [];
        var videoFiles = [];
        var MAX_VIDEO_DURATION = 120; // 2 minutes in seconds
        var MAX_VIDEO_MB       = 150; // 150 MB hard cap

        document.getElementById('photoFileInput').addEventListener('change', function() {
            addFiles(this.files, 'photo'); this.value = '';
        });
        document.getElementById('videoFileInput').addEventListener('change', function() {
            addFiles(this.files, 'video'); this.value = '';
        });

        function addFiles(fileList, type) {
            var arr   = type === 'photo' ? photoFiles : videoFiles;
            var limit = type === 'photo' ? 6 : 3;
            var grid  = document.getElementById(type === 'photo' ? 'photoThumbGrid' : 'videoThumbGrid');

            for (var i = 0; i < fileList.length; i++) {
                if (arr.length >= limit) {
                    showMediaError('Maximum ' + limit + (type === 'photo' ? ' photos' : ' videos') + ' allowed.');
                    break;
                }
                (function(file) {
                    if (type === 'video') {
                        // Check file size first (fast)
                        if (file.size > MAX_VIDEO_MB * 1024 * 1024) {
                            showMediaError(file.name + ' is too large. Maximum video size is ' + MAX_VIDEO_MB + ' MB.');
                            return;
                        }
                        // Check duration by loading metadata
                        var tempVid = document.createElement('video');
                        tempVid.preload = 'metadata';
                        tempVid.src = URL.createObjectURL(file);
                        tempVid.onloadedmetadata = function() {
                            URL.revokeObjectURL(tempVid.src);
                            if (tempVid.duration > MAX_VIDEO_DURATION) {
                                var mins = Math.floor(tempVid.duration / 60);
                                var secs = Math.round(tempVid.duration % 60);
                                showMediaError(
                                    file.name + ' is ' + mins + 'm ' + secs + 's long. ' +
                                    'Maximum allowed is 2 minutes. Please trim the video before uploading.'
                                );
                            } else {
                                arr.push(file);
                                renderThumb(file, arr.length - 1, type, grid);
                            }
                        };
                        tempVid.onerror = function() {
                            showMediaError('Could not read ' + file.name + '. Please check the file is a valid video.');
                        };
                    } else {
                        arr.push(file);
                        renderThumb(file, arr.length - 1, type, grid);
                    }
                })(fileList[i]);
            }
        }

        function showMediaError(msg) {
            var el = document.getElementById('mediaErrorMsg');
            if (!el) {
                el = document.createElement('div');
                el.id = 'mediaErrorMsg';
                el.className = 'alert alert-danger alert-dismissible mt-2';
                el.innerHTML = '<button type="button" class="btn-close" onclick="this.parentElement.remove()"></button><span id="mediaErrorText"></span>';
                var zone = document.getElementById('videoDropZone');
                zone.parentNode.insertBefore(el, zone.nextSibling);
            }
            document.getElementById('mediaErrorText').textContent = msg;
            el.style.display = 'block';
        }

        function renderThumb(file, idx, type, grid) {
            var wrap = document.createElement('div');
            wrap.className = 'hc-thumb-wrap';
            wrap.id = type + '_thumb_' + idx;

            if (file.type.startsWith('image/')) {
                var img = document.createElement('img');
                img.className = 'hc-thumb-img';
                img.alt = file.name;
                var reader = new FileReader();
                reader.onload = function(e) { img.src = e.target.result; };
                reader.readAsDataURL(file);
                wrap.appendChild(img);
            } else {
                var vid = document.createElement('video');
                vid.className = 'hc-thumb-img';
                vid.src = URL.createObjectURL(file);
                vid.muted = true;
                wrap.appendChild(vid);
            }

            var del = document.createElement('button');
            del.type = 'button';
            del.className = 'hc-thumb-del';
            del.innerHTML = '&#10005; Delete';
            del.setAttribute('data-idx', idx);
            del.setAttribute('data-type', type);
            del.addEventListener('click', function() {
                removeFile(parseInt(this.getAttribute('data-idx')), this.getAttribute('data-type'));
            });
            wrap.appendChild(del);
            grid.appendChild(wrap);
        }

        function removeFile(idx, type) {
            var arr  = type === 'photo' ? photoFiles : videoFiles;
            var grid = document.getElementById(type === 'photo' ? 'photoThumbGrid' : 'videoThumbGrid');
            arr.splice(idx, 1);
            grid.innerHTML = '';
            arr.forEach(function(f, i) { renderThumb(f, i, type, grid); });
        }

        ['photoDropZone','videoDropZone'].forEach(function(zoneId) {
            var zone = document.getElementById(zoneId);
            var type = zoneId === 'photoDropZone' ? 'photo' : 'video';
            zone.addEventListener('dragover',  function(e) { e.preventDefault(); zone.classList.add('hc-upload-zone-hover'); });
            zone.addEventListener('dragleave', function()  { zone.classList.remove('hc-upload-zone-hover'); });
            zone.addEventListener('drop', function(e) {
                e.preventDefault(); zone.classList.remove('hc-upload-zone-hover');
                addFiles(e.dataTransfer.files, type);
            });
        });

        // Document upload confirmation tick
        function markDoc(input, statusId) {
            var el = document.getElementById(statusId);
            if (input.files && input.files[0]) {
                el.innerHTML = '<span class="text-success small fw-semibold">&#10003; ' + input.files[0].name + '</span>';
            } else {
                el.innerHTML = '';
            }
        }

        // Highlight checkbox tiles on check/uncheck
        document.querySelectorAll('.hc-tile-cb').forEach(function(cb) {
            cb.addEventListener('change', function() {
                this.closest('.hc-check-tile').classList.toggle('hc-tile-checked', this.checked);
            });
            if (cb.checked) cb.closest('.hc-check-tile').classList.add('hc-tile-checked');
        });

        // ── Extras builder ────────────────────────────────────────────
        var extraCount = 0;

        function addExtraRow(name, price) {
            extraCount++;
            var id  = 'extra_' + extraCount;
            var row = document.createElement('div');
            row.className = 'hc-extra-row d-flex gap-2 align-items-center mb-2';
            row.id = id;
            row.innerHTML =
                '<input type="text"   name="extraName"  class="form-control" placeholder="Extra name (e.g. Champagne Package)" value="' + (name  || '') + '" required />' +
                '<div class="input-group" style="max-width:160px;">' +
                '  <span class="input-group-text fw-bold">R</span>' +
                '  <input type="number" name="extraPrice" class="form-control" placeholder="0.00" min="0" step="any" value="' + (price || '') + '" required />' +
                '</div>' +
                '<button type="button" class="btn btn-outline-danger btn-sm" onclick="removeExtraRow(\'' + id + '\')" title="Remove">&#10005;</button>';
            document.getElementById('extrasContainer').appendChild(row);
        }

        function removeExtraRow(id) {
            var el = document.getElementById(id);
            if (el) el.remove();
        }

        // ── Duration range validator ────────────────────────────────
        function validateDurationRange() {
            var minMins = parseInt(document.querySelector('[name="DefaultTripDurationMinutes"]:checked')?.value) || 0;
            var maxHrs  = parseInt(document.querySelector('[name="MaxBookingHours"]:checked')?.value);
            var minHrs  = Math.ceil(minMins / 60);
            var errEl   = document.getElementById('durationRangeError');
            var prevEl  = document.getElementById('durationPreviewText');

            if (minHrs > 0) {
                if (maxHrs > 0 && maxHrs < minHrs) {
                    if (errEl) errEl.style.display = 'block';
                } else {
                    if (errEl) errEl.style.display = 'none';
                    if (prevEl) {
                        if (maxHrs === 0) {
                            prevEl.textContent = minHrs + (minHrs === 1 ? ' hr' : ' hrs') + ' and above (limited by operating hours)';
                        } else {
                            var opts = [];
                            for (var h = minHrs; h <= maxHrs; h++) opts.push(h + (h === 1 ? ' hr' : ' hrs'));
                            prevEl.textContent = opts.join(', ');
                        }
                    }
                }
            } else {
                if (prevEl) prevEl.textContent = '\u2014';
            }

            document.querySelectorAll('#minDurGroup .hc-slot-btn, #maxDurGroup .hc-slot-btn').forEach(function(lbl) {
                var radio = lbl.querySelector('input');
                lbl.classList.toggle('hc-slot-selected', radio && radio.checked);
            });
        }
        document.addEventListener('DOMContentLoaded', validateDurationRange);

        function toggleDisabilityDetails(cb) {
            document.getElementById('disabilityDetails').style.display = cb.checked ? 'block' : 'none';
        }
    </script>

    <style>
