@model APDP.Models.Customer
@{
    ViewBag.Title = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card hc-form-card">
                <div class="card-header hc-form-header-green">
                    <h4 class="mb-0">&#127754; Create Your HarbourConnect Account</h4>
                    <p class="mb-0 small">Discover and book unforgettable boat trips in Durban Harbour.</p>
                </div>
                <div class="card-body p-4">

                    @using (Html.BeginForm("Register", "Customer", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        if (!ViewData.ModelState.IsValid)
                        {
                            @Html.ValidationSummary(true, "Please fix the errors below:", new { @class = "alert alert-danger" })
                        }

                        @* Full Name *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Your full name" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>

                        @* Phone with country code dropdown *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <select id="countryCode" class="form-select hc-country-select" style="max-width:160px;">
                                    <option value="+27"  selected>&#127480;&#127462; +27</option>
                                    <option value="+263">&#127487;&#127484; +263</option>
                                    <option value="+258">&#127474;&#127487; +258</option>
                                    <option value="+268">&#127480;&#127487; +268</option>
                                    <option value="+266">&#127473;&#127480; +266</option>
                                    <option value="+44"> &#127468;&#127463; +44</option>
                                </select>
                                <input type="tel" id="phoneLocal" class="form-control"
                                       placeholder="821234567"
                                       maxlength="9" inputmode="numeric" />
                                @Html.HiddenFor(m => m.PhoneNumber, new { id = "phoneHidden" })
                            </div>
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                        </div>

                        @* Email *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text">&#9993;</span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "your@email.com", type = "email" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        @* Password *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.Password, new
                                {
                                    @class      = "form-control",
                                    type        = "password",
                                    id          = "pwdInput",
                                    placeholder = "Minimum 6 characters"
                                })
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="var f=document.getElementById('pwdInput');f.type=f.type==='password'?'text':'password';"
                                        tabindex="-1">&#128065;</button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-success btn-lg">
                                Create Account
                            </button>
                        </div>
                    }

                    <hr class="mt-4" />
                    <p class="text-center text-muted mb-0">
                        Already have an account?
                        @Html.ActionLink("Login here", "Login", "Customer", null, new { @class = "text-success fw-semibold" })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        // Combine country code + local number into the hidden PhoneNumber field before submit
        var form = document.querySelector('form');
        form.addEventListener('submit', function () {
            var code  = document.getElementById('countryCode').value;
            var local = document.getElementById('phoneLocal').value.trim();

            // If user typed with leading 0, strip it before adding country code
            // e.g. 0821234567 + +27 => +27821234567
            if (local.startsWith('0')) {
                local = local.substring(1);
            }
            // If they already typed the full number with +, use as-is
            if (local.startsWith('+')) {
                document.getElementById('phoneHidden').value = local;
            } else {
                document.getElementById('phoneHidden').value = code + local;
            }
        });

        // Live preview of the combined number
        ['countryCode', 'phoneLocal'].forEach(function(id) {
            document.getElementById(id).addEventListener('input', function() {
                var code  = document.getElementById('countryCode').value;
                var local = document.getElementById('phoneLocal').value.trim();
                if (local.startsWith('0')) local = local.substring(1);
                var preview = local.startsWith('+') ? local : code + local;
                document.getElementById('phoneHidden').value = preview;
            });
        });
    </script>

    <style>
        .hc-country-select { border-right: none; border-radius: 0.375rem 0 0 0.375rem; }
    </style>
}
