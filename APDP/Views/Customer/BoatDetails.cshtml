@model APDP.Models.Boat
@{
    ViewBag.Title = Model.BoatName + " - Details";
    var recentRatings = ViewBag.RecentRatings as IEnumerable<APDP.Models.BoatRating>;

    var allPhotos = new[] {
        Model.ImagePath, Model.ImagePath2, Model.ImagePath3,
        Model.ImagePath4, Model.ImagePath5, Model.ImagePath6
    }.Where(p => !string.IsNullOrEmpty(p)).ToArray();

    var allVideos = new[] { Model.VideoPath1, Model.VideoPath2, Model.VideoPath3 }
        .Where(v => !string.IsNullOrEmpty(v)).ToArray();

    bool hasExtras = Model.Extras != null && Model.Extras.Any();
}

@* ── Hero Photo Gallery ──────────────────────────────────────────── *@
<div class="bd-gallery">
    @if (allPhotos.Length >= 2)
    {
        <div class="bd-gallery-main">
            <img src="@Url.Content(allPhotos[0])" id="bdMainPhoto" class="bd-gallery-main-img" alt="@Model.BoatName" />
        </div>
        <div class="bd-gallery-grid">
            @for (int i = 1; i < Math.Min(allPhotos.Length, 5); i++)
            {
                <img src="@Url.Content(allPhotos[i])"
                     class="bd-gallery-thumb @(i == Math.Min(allPhotos.Length,5)-1 && allPhotos.Length > 5 ? "bd-gallery-more" : "")"
                     onclick="bdSwapPhoto(this)"
                     alt="Photo @(i+1)" />
            }
        </div>
    }
    else if (allPhotos.Length == 1)
    {
        <div class="bd-gallery-single">
            <img src="@Url.Content(allPhotos[0])" class="bd-gallery-single-img" alt="@Model.BoatName" />
        </div>
    }
    else
    {
        <div class="bd-gallery-placeholder">
            <span>&#128674;</span>
            <p>No photos available</p>
        </div>
    }
</div>

@* ── Page Body ───────────────────────────────────────────────────── *@
<div class="bd-body">
    <div class="bd-main">

        @* ── Title Block ─────────────────────────────────────────── *@
        <div class="bd-title-block">
            <div>
                <h1 class="bd-title">@Model.BoatName</h1>
                <p class="bd-breadcrumb">
                    South Africa &rsaquo; KwaZulu-Natal &rsaquo; @Model.HarbourLocation &rsaquo; @Model.BoatType
                </p>
            </div>
        </div>

        @* ── Description ─────────────────────────────────────────── *@
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="bd-section">
                <div class="bd-desc-item">
                    <span class="bd-desc-icon">&#128674;</span>
                    <p class="bd-desc-text">@Model.Description</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.DisabilityAccommodation) || Model.IsDisabilityFriendly)
                {
                    <div class="bd-desc-item">
                        <span class="bd-desc-icon">&#9855;</span>
                        <p class="bd-desc-text text-success">
                            @if (!string.IsNullOrWhiteSpace(Model.DisabilityAccommodation))
                            { @Model.DisabilityAccommodation }
                            else
                            { <text>This boat accommodates people with disabilities.</text> }
                        </p>
                    </div>
                }
            </div>
        }

        @* ── Key Details ─────────────────────────────────────────── *@
        <div class="bd-section">
            <h2 class="bd-section-title">Key Details</h2>
            <div class="bd-details-grid">
                <div class="bd-detail-item">
                    <span class="bd-detail-label">Registration</span>
                    <span class="bd-detail-value"><code>@Model.RegistrationNumber</code></span>
                </div>
                <div class="bd-detail-item">
                    <span class="bd-detail-label">Boat Type</span>
                    <span class="bd-detail-value">@Model.BoatType</span>
                </div>
                <div class="bd-detail-item">
                    <span class="bd-detail-label">Location</span>
                    <span class="bd-detail-value">&#128205; @Model.HarbourLocation</span>
                </div>
                <div class="bd-detail-item">
                    <span class="bd-detail-label">Max Passengers</span>
                    <span class="bd-detail-value">@Model.MaxPassengers persons</span>
                </div>
                <div class="bd-detail-item">
                    <span class="bd-detail-label">Adult Rate</span>
                    <span class="bd-detail-value fw-bold">R @Model.PriceAdult.ToString("N2") / hr</span>
                </div>
                <div class="bd-detail-item">
                    <span class="bd-detail-label">Child Rate</span>
                    <span class="bd-detail-value fw-bold">R @Model.PriceChild.ToString("N2") / hr</span>
                </div>
            </div>
        </div>

        @* ── Safety & Features ────────────────────────────────────── *@
        @{
            bool hasSafety   = Model.HasLifeJackets || Model.HasMedKit || Model.HasFireExtinguisher;
            bool hasFeatures = Model.HasFishingEquipment || Model.HasDecoration || Model.HasSoundSystem;
        }
        <div class="bd-section">
            <h2 class="bd-section-title">Sailing hours</h2>
            @Html.Partial("_SailingHours", ViewBag.Week as List<APDP.Helpers.DayHours>,
                new ViewDataDictionary { { "BufferMinutes", Model.BufferMinutes } })
        </div>

        @if (hasSafety || hasFeatures)
        {
            <div class="bd-section">
                <h2 class="bd-section-title">What's on board</h2>
                <div class="bd-chips">
                    @if (Model.HasLifeJackets)      { <span class="bd-chip bd-chip-green">&#10003; Life Jackets</span> }
                    @if (Model.HasMedKit)           { <span class="bd-chip bd-chip-green">&#10003; Med Kit</span> }
                    @if (Model.HasFireExtinguisher) { <span class="bd-chip bd-chip-green">&#10003; Fire Extinguisher</span> }
                    @if (Model.HasFishingEquipment) { <span class="bd-chip bd-chip-blue">&#10003; Fishing Equipment</span> }
                    @if (Model.HasDecoration)       { <span class="bd-chip bd-chip-blue">&#10003; Decoration</span> }
                    @if (Model.HasSoundSystem)      { <span class="bd-chip bd-chip-blue">&#10003; Sound System</span> }
                </div>
            </div>
        }

        @* ── Paid Extras ─────────────────────────────────────────── *@
        @if (hasExtras)
        {
            <div class="bd-section">
                <h2 class="bd-section-title">Paid Add-Ons <span class="bd-section-sub">(select at booking)</span></h2>
                <div class="bd-extras-list">
                    @foreach (var extra in Model.Extras)
                    {
                        <div class="bd-extra-row">
                            <span>@extra.Name</span>
                            <span class="bd-extra-price">+ R @extra.Price.ToString("N2")</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Videos ──────────────────────────────────────────────── *@
        @if (allVideos.Length > 0)
        {
            <div class="bd-section">
                <h2 class="bd-section-title">Videos</h2>
                <div class="bd-videos">
                    @foreach (var v in allVideos)
                    {
                        <video src="@Url.Content(v)" class="bd-video" controls muted playsinline></video>
                    }
                </div>
            </div>
        }

        @* ── Owner ────────────────────────────────────────────────── *@
        <div class="bd-section">
            <h2 class="bd-section-title">About the Owner</h2>
            <div class="bd-owner-card">
                <div class="bd-owner-avatar">@(string.IsNullOrWhiteSpace(Model.BoatOwner.BusinessName) ? "?" : Model.BoatOwner.BusinessName.Trim().Substring(0, 1).ToUpper())</div>
                <div>
                    <p class="bd-owner-name">@Model.BoatOwner.BusinessName</p>
                    <p class="bd-owner-contact">&#128222; @Model.BoatOwner.PhoneNumber &nbsp;&bull;&nbsp; &#128231; @Model.BoatOwner.Email</p>
                </div>
            </div>
        </div>

        @* ── Ratings ─────────────────────────────────────────────── *@
        <div class="bd-section">
            @if (Model.TotalRatings > 0)
            {
                <h2 class="bd-section-title">
                    &#9733; @Model.AverageRating.ToString("0.0")
                    <span class="bd-section-sub">(@Model.TotalRatings @(Model.TotalRatings == 1 ? "review" : "reviews"))</span>
                </h2>
                if (recentRatings != null)
                {
                    foreach (var r in recentRatings)
                    {
                        <div class="bd-review">
                            <div class="bd-review-header">
                                <strong>@r.Customer.FullName</strong>
                                <span class="bd-review-date">@r.DateRated.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="bd-review-stars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <span class="@(s <= r.Stars ? "bd-star filled" : "bd-star")">&#9733;</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(r.Comment))
                            {
                                <p class="bd-review-comment">&ldquo;@r.Comment&rdquo;</p>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <h2 class="bd-section-title">Reviews</h2>
                <p class="text-muted">No ratings yet. Book this boat and be the first to review it!</p>
            }
        </div>

    </div>

    @* ── Booking Sidebar ─────────────────────────────────────────── *@
    <div class="bd-sidebar">
        <div class="bd-booking-card">
            <div class="bd-booking-price">
                <span class="bd-price-amount">R @Model.PriceAdult.ToString("N2")</span>
                <span class="bd-price-unit">/hour adult</span>
            </div>
            @if (Model.TotalRatings > 0)
            {
                <div class="bd-booking-rating">
                    <span class="bd-star filled">&#9733;</span>
                    <span class="fw-bold">@Model.AverageRating.ToString("0.0")</span>
                    <span class="text-muted small">&nbsp;(@Model.TotalRatings @(Model.TotalRatings == 1 ? "review" : "reviews"))</span>
                </div>
            }

            <div class="bd-booking-detail-row">
                <span>Child rate</span>
                <span>R @Model.PriceChild.ToString("N2") /hour</span>
            </div>
            <div class="bd-booking-detail-row">
                <span>Max passengers</span>
                <span>@Model.MaxPassengers persons</span>
            </div>
            <div class="bd-booking-detail-row">
                <span>Location</span>
                <span>@Model.HarbourLocation</span>
            </div>
            <div class="bd-booking-detail-row">
                <span>Type</span>
                <span>@Model.BoatType</span>
            </div>

            @if (Model.Status == APDP.Models.BoatStatus.Inactive)
            {
                <div class="bd-unavailable">Currently Unavailable</div>
            }
            else
            {
                @Html.ActionLink("Book Now", "BookBoat", "Customer",
                    new { id = Model.BoatID },
                    new { @class = "bd-book-btn" })
            }

            <a href="@Url.Action("Boats", "Customer")" class="bd-back-btn">&larr; Back to Boats</a>
        </div>
    </div>
</div>

<style>
    /* ── Gallery ──────────────────────────────────────────── */
    body { background: var(--hc-surface) !important; }

    .bd-gallery {
        display: flex;
        height: 420px;
        overflow: hidden;
        background: #111;
    }

    .bd-gallery-main {
        flex: 1;
        overflow: hidden;
        border-right: 3px solid var(--hc-surface);
    }

    .bd-gallery-main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        cursor: pointer;
        transition: transform 0.3s;
    }

    .bd-gallery-main-img:hover { transform: scale(1.02); }

    .bd-gallery-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        grid-template-rows: 1fr 1fr;
        width: 340px;
        gap: 3px;
    }

    .bd-gallery-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        cursor: pointer;
        transition: opacity 0.2s;
        display: block;
    }

    .bd-gallery-thumb:hover { opacity: 0.85; }

    .bd-gallery-single { width: 100%; }
    .bd-gallery-single-img { width: 100%; height: 420px; object-fit: cover; display: block; }

    .bd-gallery-placeholder {
        width: 100%;
        height: 420px;
        background: #1a3a5c;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 4rem;
    }

    .bd-gallery-placeholder p { font-size: 1rem; margin-top: 10px; opacity: 0.6; }

    /* ── Body layout ──────────────────────────────────────── */
    .bd-body {
        max-width: 1100px;
        margin: 0 auto;
        padding: 32px 24px;
        display: flex;
        gap: 40px;
        align-items: flex-start;
        background: var(--hc-surface);
    }

    .bd-main { flex: 1; min-width: 0; }

    /* ── Title ────────────────────────────────────────────── */
    .bd-title-block {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--hc-border);
    }

    .bd-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--hc-heading);
        margin: 0 0 6px 0;
    }

    .bd-breadcrumb {
        font-size: 0.85rem;
        color: var(--hc-primary);
        margin: 0;
    }

    /* ── Sections ─────────────────────────────────────────── */
    .bd-section {
        padding: 24px 0;
        border-bottom: 1px solid var(--hc-border);
    }

    .bd-section-title {
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--hc-heading);
        margin-bottom: 16px;
    }

    .bd-section-sub {
        font-size: 0.85rem;
        font-weight: 400;
        color: var(--hc-text-muted);
    }

    /* Description */
    .bd-desc-item {
        display: flex;
        gap: 14px;
        margin-bottom: 14px;
    }

    .bd-desc-icon { font-size: 1.3rem; flex-shrink: 0; margin-top: 2px; }
    .bd-desc-text { font-size: 0.95rem; color: var(--hc-text); line-height: 1.6; margin: 0; }

    /* Key details grid */
    .bd-details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .bd-detail-item {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .bd-detail-label { font-size: 0.75rem; color: var(--hc-text-muted); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
    .bd-detail-value { font-size: 0.95rem; color: var(--hc-text); }

    /* Chips */
    .bd-chips { display: flex; flex-wrap: wrap; gap: 8px; }

    .bd-chip {
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.83rem;
        font-weight: 500;
    }

    .bd-chip-green { background: var(--hc-success-soft); color: var(--hc-success); border: 1px solid var(--hc-success-soft); }
    .bd-chip-blue  { background: var(--hc-primary-soft); color: var(--hc-primary); border: 1px solid var(--hc-primary-border); }

    /* Extras */
    .bd-extras-list { border: 1px solid var(--hc-border); border-radius: var(--hc-radius-sm); overflow: hidden; }
    .bd-extra-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 16px;
        font-size: 0.9rem;
        border-bottom: 1px solid var(--hc-border);
    }
    .bd-extra-row:last-child { border-bottom: none; }
    .bd-extra-price { color: var(--hc-success); font-weight: 600; }

    /* Videos */
    .bd-videos { display: flex; flex-wrap: wrap; gap: 12px; }
    .bd-video { width: 100%; max-width: 420px; height: 240px; border-radius: 10px; background: #000; object-fit: contain; }

    /* Owner */
    .bd-owner-card { display: flex; align-items: center; gap: 16px; }
    .bd-owner-avatar {
        width: 52px; height: 52px;
        border-radius: 50%;
        background: var(--hc-primary);
        color: var(--hc-on-primary);
        font-size: 1.4rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .bd-owner-name    { color: var(--hc-heading); font-weight: 700; font-size: 0.95rem; margin: 0 0 4px 0; }
    .bd-owner-contact { font-size: 0.82rem; color: var(--hc-text-muted); margin: 0; }

    /* Reviews */
    .bd-review { padding: 16px 0; border-bottom: 1px solid var(--hc-border); }
    .bd-review:last-child { border-bottom: none; }
    .bd-review-header { display: flex; justify-content: space-between; margin-bottom: 6px; }
    .bd-review-date   { font-size: 0.8rem; color: var(--hc-text-muted); }
    .bd-review-stars  { display: flex; gap: 2px; margin-bottom: 6px; }
    .bd-star          { color: var(--hc-border-strong); font-size: 0.95rem; }
    .bd-star.filled   { color: #f9a825; }
    .bd-review-comment { font-size: 0.88rem; color: var(--hc-text-muted); margin: 0; font-style: italic; }

    /* ── Sidebar booking card ─────────────────────────────── */
    .bd-sidebar { width: 340px; flex-shrink: 0; }

    .bd-booking-card {
        position: sticky;
        top: 80px;
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius);
        padding: 24px;
        background: var(--hc-surface);
        box-shadow: var(--hc-shadow);
    }

    .bd-booking-price {
        display: flex;
        align-items: baseline;
        gap: 6px;
        margin-bottom: 4px;
    }

    .bd-price-amount { font-size: 1.6rem; font-weight: 800; color: var(--hc-heading); }
    .bd-price-unit   { font-size: 0.85rem; color: var(--hc-text-muted); }

    .bd-booking-rating {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-bottom: 20px;
        font-size: 0.88rem;
    }

    .bd-booking-detail-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.88rem;
        color: var(--hc-text-muted);
        padding: 10px 0;
        border-bottom: 1px solid var(--hc-border);
    }

    .bd-booking-detail-row span:last-child { font-weight: 600; color: var(--hc-heading); }

    .bd-book-btn {
        display: block;
        text-align: center;
        margin-top: 20px;
        background: var(--hc-primary);
        color: var(--hc-on-primary);
        padding: 14px;
        border-radius: var(--hc-radius-sm);
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.2s;
    }

    .bd-book-btn:hover { background: var(--hc-primary-hover); color: var(--hc-on-primary); }

    .bd-back-btn {
        display: block;
        text-align: center;
        margin-top: 10px;
        color: var(--hc-text-muted);
        font-size: 0.85rem;
        text-decoration: none;
        padding: 8px;
    }

    .bd-back-btn:hover { color: var(--hc-heading); }

    .bd-unavailable {
        display: block;
        text-align: center;
        margin-top: 20px;
        background: var(--hc-surface-3);
        color: var(--hc-text-muted);
        padding: 14px;
        border-radius: var(--hc-radius-sm);
        font-size: 1rem;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .bd-body { flex-direction: column; padding: 16px; }
        .bd-sidebar { width: 100%; }
        .bd-gallery { height: 260px; }
        .bd-gallery-grid { width: 160px; }
        .bd-details-grid { grid-template-columns: 1fr; }
    }
</style>

@section scripts {
    <script>
        function bdSwapPhoto(thumb) {
            var main = document.getElementById('bdMainPhoto');
            if (!main) return;
            var tmp = main.src;
            main.src = thumb.src;
            thumb.src = tmp;
        }
    </script>
}
