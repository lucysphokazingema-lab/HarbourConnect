@model APDP.Models.Boat
@{
    ViewBag.Title = "Add New Boat";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-9">

            <div class="card hc-form-card">
                <div class="card-header hc-form-header">
                    <h4 class="mb-0">&#10133; Add New Boat</h4>
                    <p class="mb-0 small">All boats are submitted for TNPA review before going live.</p>
                </div>
                <div class="card-body p-4">

                    @using (Html.BeginForm("AddBoat", "BoatOwner", FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "Please fix the following errors:", new { @class = "alert alert-danger" })

                        <h6 class="hc-form-section-title">Boat Details</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.BoatName, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.BoatName, new { @class = "form-control", placeholder = "e.g. Sea Breeze" })
                                @Html.ValidationMessageFor(m => m.BoatName, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.RegistrationNumber, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.RegistrationNumber, new { @class = "form-control", placeholder = "e.g. SA-DRB-1234" })
                                @Html.ValidationMessageFor(m => m.RegistrationNumber, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.BoatType, new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(m => m.BoatType,
                                    new SelectList(new[] { "Fishing Boat", "Leisure Cruiser", "Speed Boat", "Yacht", "Catamaran", "Party Boat", "Other" }),
                                    "-- Select Boat Type --",
                                    new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.BoatType, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.HarbourLocation, new { @class = "form-label fw-semibold" })
                                @Html.DropDownListFor(m => m.HarbourLocation,
                                    new SelectList(new[] { "Durban Harbour", "Cape Town Harbour", "Port Elizabeth", "East London", "Richards Bay" }),
                                    "-- Select Location --",
                                    new { @class = "form-select" })
                                @Html.ValidationMessageFor(m => m.HarbourLocation, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-semibold" })
                            @Html.TextAreaFor(m => m.Description, 3, 0, new { @class = "form-control", placeholder = "Describe your boat and what it offers..." })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                        </div>

                        <h6 class="hc-form-section-title mt-3">Capacity &amp; Pricing</h6>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.MaxPassengers, new { @class = "form-label fw-semibold" })
                                @Html.TextBoxFor(m => m.MaxPassengers, new { @class = "form-control", type = "number", min = "1", max = "200" })
                                @Html.ValidationMessageFor(m => m.MaxPassengers, "", new { @class = "text-danger small" })
                            </div>
                            <div class="col-md-6 mb-3">
                                @Html.LabelFor(m => m.PricePerTrip, new { @class = "form-label fw-semibold" })
                                <div class="input-group">
                                    <span class="input-group-text">R</span>
                                    @Html.TextBoxFor(m => m.PricePerTrip, new { @class = "form-control", type = "number", min = "0", step = "0.01" })
                                </div>
                                @Html.ValidationMessageFor(m => m.PricePerTrip, "", new { @class = "text-danger small" })
                            </div>
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(m => m.LifeJacketQuantity, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.LifeJacketQuantity, new { @class = "form-control", type = "number", min = "0" })
                            @Html.ValidationMessageFor(m => m.LifeJacketQuantity, "", new { @class = "text-danger small" })
                        </div>

                        <h6 class="hc-form-section-title mt-3">Features &amp; Extras</h6>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.HasFishingEquipment, new { @class = "form-check-input" })
                                    @Html.LabelFor(m => m.HasFishingEquipment, new { @class = "form-check-label" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.HasDecoration, new { @class = "form-check-input" })
                                    @Html.LabelFor(m => m.HasDecoration, new { @class = "form-check-label" })
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check">
                                    @Html.CheckBoxFor(m => m.HasSoundSystem, new { @class = "form-check-input" })
                                    @Html.LabelFor(m => m.HasSoundSystem, new { @class = "form-check-label" })
                                </div>
                            </div>
                        </div>

                        <h6 class="hc-form-section-title mt-3">Boat Photos</h6>
                        <p class="text-muted small mb-3">Upload up to 3 photos of your boat. Each photo helps customers see exactly what they are booking.</p>

                        <div class="row g-3 mb-3">

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">&#128674; Main Photo</label>
                                <small class="d-block text-muted mb-2">Front or full view of the boat</small>
                                <input type="file" name="imageFile" id="imgInput1" class="form-control" accept=".jpg,.jpeg,.png,.gif" onchange="previewImage(this,'prev1')" />
                                <div class="mt-2 hc-img-preview-box" id="prev1box">
                                    <img id="prev1" src="#" alt="Main preview" class="hc-img-preview d-none" />
                                    <div id="prev1placeholder" class="hc-img-placeholder">
                                        <span>&#128247;</span><br /><small>No image selected</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">&#8592; Side View Photo</label>
                                <small class="d-block text-muted mb-2">Side profile of the boat</small>
                                <input type="file" name="imageFile2" id="imgInput2" class="form-control" accept=".jpg,.jpeg,.png,.gif" onchange="previewImage(this,'prev2')" />
                                <div class="mt-2 hc-img-preview-box" id="prev2box">
                                    <img id="prev2" src="#" alt="Side view preview" class="hc-img-preview d-none" />
                                    <div id="prev2placeholder" class="hc-img-placeholder">
                                        <span>&#128247;</span><br /><small>No image selected</small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">&#127968; Interior Photo</label>
                                <small class="d-block text-muted mb-2">Inside / deck view of the boat</small>
                                <input type="file" name="imageFile3" id="imgInput3" class="form-control" accept=".jpg,.jpeg,.png,.gif" onchange="previewImage(this,'prev3')" />
                                <div class="mt-2 hc-img-preview-box" id="prev3box">
                                    <img id="prev3" src="#" alt="Interior preview" class="hc-img-preview d-none" />
                                    <div id="prev3placeholder" class="hc-img-placeholder">
                                        <span>&#128247;</span><br /><small>No image selected</small>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Submit for TNPA Approval
                            </button>
                            @Html.ActionLink("Cancel", "MyBoats", "BoatOwner", null, new { @class = "btn btn-outline-secondary btn-lg" })
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        function previewImage(input, previewId) {
            var img         = document.getElementById(previewId);
            var placeholder = document.getElementById(previewId + 'placeholder');

            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    placeholder.style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            } else {
                img.classList.add('d-none');
                placeholder.style.display = 'flex';
            }
        }
    </script>

    <style>
        .hc-img-preview-box {
            border: 2px dashed #b2dfdb;
            border-radius: 10px;
            overflow: hidden;
            background: #f0f7f5;
            min-height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hc-img-preview {
            width: 100%;
            height: 140px;
            object-fit: cover;
            display: block;
        }

        .hc-img-placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #90a4ae;
            font-size: 2rem;
            width: 100%;
            height: 140px;
            text-align: center;
        }

        .hc-img-placeholder small {
            font-size: 0.75rem;
            margin-top: 4px;
        }
    </style>
}
