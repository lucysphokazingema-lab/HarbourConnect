@model IEnumerable<APDP.Models.Boat>
@{
    ViewBag.Title = "Available Boats";
}

<div class="container py-4">

    <h2 class="mb-3">&#128674; Available Boats</h2>

    @* Filter Bar *@
    @using (Html.BeginForm("Boats", "Customer", FormMethod.Get, new { @class = "mb-4" }))
    {
        <div class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label small fw-semibold">Filter by Type</label>
                <select name="boatType" class="form-select">
                    <option value="">All Types</option>
                    <option value="Fishing Boat"    @(ViewBag.SelectedType == "Fishing Boat"    ? "selected" : "")>Fishing Boat</option>
                    <option value="Leisure Cruiser" @(ViewBag.SelectedType == "Leisure Cruiser" ? "selected" : "")>Leisure Cruiser</option>
                    <option value="Speed Boat"      @(ViewBag.SelectedType == "Speed Boat"      ? "selected" : "")>Speed Boat</option>
                    <option value="Yacht"           @(ViewBag.SelectedType == "Yacht"           ? "selected" : "")>Yacht</option>
                    <option value="Catamaran"       @(ViewBag.SelectedType == "Catamaran"       ? "selected" : "")>Catamaran</option>
                    <option value="Party Boat"      @(ViewBag.SelectedType == "Party Boat"      ? "selected" : "")>Party Boat</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
            </div>
            <div class="col-md-3">
                @Html.ActionLink("Clear", "Boats", "Customer", null, new { @class = "btn btn-outline-secondary w-100" })
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h5>No boats match your search.</h5>
            <p>Try changing the filters or check back later.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var boat in Model)
            {
                <div class="col-md-4">
                    <div class="card hc-boat-card h-100">

                        @* Boat image *@
                        @if (!string.IsNullOrEmpty(boat.ImagePath))
                        {
                            <img src="@Url.Content(boat.ImagePath)" class="card-img-top hc-boat-card-img" alt="@boat.BoatName" />
                        }
                        else
                        {
                            <div class="hc-boat-card-img-placeholder d-flex align-items-center justify-content-center">
                                <span style="font-size:3rem;">&#128674;</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            @* Title + star rating row *@
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h5 class="card-title mb-0">@boat.BoatName</h5>
                                @if (boat.TotalRatings > 0)
                                {
                                    <div class="hc-star-rating-sm" title="@boat.AverageRating.ToString("0.0") out of 5">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= (int)Math.Round(boat.AverageRating))
                                            { <span class="hc-star filled">&#9733;</span> }
                                            else
                                            { <span class="hc-star">&#9734;</span> }
                                        }
                                        <span class="hc-rating-count">(@boat.TotalRatings)</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">No ratings</span>
                                }
                            </div>

                            <p class="text-muted small mb-1"><strong>Type:</strong> @boat.BoatType</p>
                            <p class="text-muted small mb-1"><strong>Location:</strong> @boat.HarbourLocation</p>
                            <p class="text-muted small mb-1"><strong>Max Passengers:</strong> @boat.MaxPassengers</p>

                            @* Equipment & safety badges *@
                            <div class="mt-2 mb-2 d-flex flex-wrap gap-1">
                                @if (boat.LifeJacketQuantity > 0)
                                {
                                    <span class="badge hc-badge-safety" title="Life jackets on board">&#129399; @boat.LifeJacketQuantity Jackets</span>
                                }
                                @if (boat.HasMedKit)
                                {
                                    <span class="badge hc-badge-safety" title="Medical kit on board">&#129657; Med Kit</span>
                                }
                                @if (boat.HasFireExtinguisher)
                                {
                                    <span class="badge hc-badge-safety" title="Fire extinguisher on board">&#128293; Fire Ext.</span>
                                }
                                @if (boat.HasFishingEquipment)
                                {
                                    <span class="badge bg-secondary">&#127907; Fishing</span>
                                }
                                @if (boat.HasDecoration)
                                {
                                    <span class="badge bg-secondary">&#127881; Decor</span>
                                }
                                @if (boat.HasSoundSystem)
                                {
                                    <span class="badge bg-secondary">&#127925; Sound</span>
                                }
                                @if (!string.IsNullOrEmpty(boat.DisabilityAccommodation))
                                {
                                    <span class="badge hc-badge-access" title="@boat.DisabilityAccommodation">&#9855; Accessible</span>
                                }
                            </div>

                            <p class="hc-price-tag mt-auto">R @boat.PricePerTrip.ToString("N2") <small class="text-muted fw-normal">/ trip</small></p>
                            <div class="d-flex gap-2 mt-2">
                                @Html.ActionLink("View Details", "BoatDetails", "Customer", new { id = boat.BoatID }, new { @class = "btn btn-outline-primary btn-sm flex-fill" })
                                @Html.ActionLink("Book Now", "BookBoat", "Customer", new { id = boat.BoatID }, new { @class = "btn btn-success btn-sm flex-fill" })
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        @Html.ActionLink("Back to Dashboard", "Dashboard", "Customer", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<style>
    .hc-star-rating-sm { display: inline-flex; align-items: center; gap: 1px; flex-shrink: 0; }
    .hc-star { color: #ccc; font-size: 0.9rem; }
    .hc-star.filled { color: #f9a825; }
    .hc-rating-count { font-size: 0.72rem; color: #888; margin-left: 2px; }
    .hc-badge-safety { background-color: #1b5e20; color: #fff; }
    .hc-badge-access { background-color: #1565c0; color: #fff; }
</style>
