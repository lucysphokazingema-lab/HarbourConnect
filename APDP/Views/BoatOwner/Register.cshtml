@model APDP.Models.BoatOwner
@{
    ViewBag.Title = "Boat Owner Registration";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card hc-form-card">
                <div class="card-header hc-form-header">
                    <h4 class="mb-0">&#128674; Boat Owner Registration</h4>
                    <p class="mb-0 small">Create your HarbourConnect account</p>
                </div>
                <div class="card-body p-4">

                    @using (Html.BeginForm("Register", "BoatOwner", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "Please fix the following errors:", new { @class = "alert alert-danger" })

                        @* Full Name *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Enter your full name" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>

                        @* Business Name *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.BusinessName, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.BusinessName, new { @class = "form-control", placeholder = "Enter your business or trading name" })
                            @Html.ValidationMessageFor(m => m.BusinessName, "", new { @class = "text-danger small" })
                        </div>

                        @* Phone Number - SA format with +27 prefix *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text hc-sa-flag" title="South Africa">
                                    &#127480;&#127462; +27
                                </span>
                                <input type="tel" id="boPhoneLocal" class="form-control"
                                       placeholder="Enter 9 digits"
                                       maxlength="9" inputmode="numeric" />
                                @Html.HiddenFor(m => m.PhoneNumber, new { id = "boPhoneHidden" })
                            </div>
                            <small class="text-muted">Enter 9 digits after +27</small>
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                        </div>

                        @* Email *@
                        <div class="mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })
                            <div class="input-group">
                                <span class="input-group-text">&#9993;</span>
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email address", type = "email" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>

                        @* Password *@
                        <div class="mb-2">
                            @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Password, new
                            {
                                @class       = "form-control",
                                type         = "password",
                                id           = "passwordInput",
                                placeholder  = "Create a password",
                                oninput      = "checkStrength(this.value)",
                                autocomplete = "new-password"
                            })
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })

                            @* Password strength bar *@
                            <div class="mt-2">
                                <div class="progress" style="height:6px;">
                                    <div id="strengthBar" class="progress-bar" role="progressbar" style="width:0%; transition:width 0.3s;"></div>
                                </div>
                                <small id="strengthLabel" class="text-muted">Password strength: enter a password above</small>
                            </div>
                        </div>

                        @* Confirm Password *@
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Confirm Password</label>
                            <input type="password" class="form-control" id="confirmPassword"
                                   placeholder="Re-enter your password"
                                   autocomplete="new-password"
                                   oninput="checkMatch()" />
                            <small id="matchMsg" class="text-muted">Re-enter the password above to confirm.</small>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                                Create Account
                            </button>
                        </div>
                    }

                    <hr class="mt-4" />
                    <p class="text-center text-muted mb-0">
                        Already have an account?
                        @Html.ActionLink("Login here", "Login", "BoatOwner", null, new { @class = "text-primary fw-semibold" })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <script>
        // ── Phone: combine +27 + local digits into hidden field ────
        function buildBoPhone() {
            var local = document.getElementById('boPhoneLocal').value.replace(/\D/g,'');
            if (local.startsWith('0')) local = local.substring(1);
            document.getElementById('boPhoneHidden').value = local ? '+27' + local : '';
        }
        var boPhoneEl = document.getElementById('boPhoneLocal');
        if (boPhoneEl) {
            boPhoneEl.addEventListener('input', buildBoPhone);
            document.querySelector('form').addEventListener('submit', buildBoPhone);
        }

        function checkStrength(val) {
            var score = 0;
            if (val.length >= 8)      score++;
            if (/[A-Z]/.test(val))    score++;
            if (/[a-z]/.test(val))    score++;
            if (/\d/.test(val))       score++;

            var bar = document.getElementById('strengthBar');
            var lbl = document.getElementById('strengthLabel');
            var pct = (score / 4) * 100;
            bar.style.width = pct + '%';

            if (score === 0) {
                bar.className = 'progress-bar bg-danger';
                lbl.textContent = 'Password strength: Very Weak';
                lbl.className = 'text-danger small';
            } else if (score === 1) {
                bar.className = 'progress-bar bg-danger';
                lbl.textContent = 'Password strength: Very Weak';
                lbl.className = 'text-danger small';
            } else if (score === 2) {
                bar.className = 'progress-bar bg-warning';
                lbl.textContent = 'Password strength: Fair';
                lbl.className = 'text-warning small';
            } else if (score === 3) {
                bar.className = 'progress-bar bg-primary';
                lbl.textContent = 'Password strength: Good';
                lbl.className = 'text-primary small';
            } else {
                bar.className = 'progress-bar bg-success';
                lbl.textContent = 'Password strength: Strong ✓';
                lbl.className = 'text-success small';
            }

            checkMatch();
        }

        function checkMatch() {
            var pwd     = document.getElementById('passwordInput').value;
            var confirm = document.getElementById('confirmPassword').value;
            var msg     = document.getElementById('matchMsg');
            if (confirm.length === 0) {
                msg.textContent = 'Re-enter the password above to confirm.';
                msg.className   = 'text-muted small';
            } else if (pwd === confirm) {
                msg.textContent = 'Passwords match';
                msg.className   = 'text-success small fw-semibold';
            } else {
                msg.textContent = 'Passwords do not match.';
                msg.className   = 'text-danger small fw-semibold';
            }
        }
    </script>

    <style>
        .hc-sa-flag   { font-size: 1rem; background: var(--hc-surface-2); }
        .hc-pwd-rules { margin-top: 6px; }
        .hc-pwd-rules li { color: var(--hc-text-muted); padding: 1px 0; }
    </style>
}
