@{
    ViewBag.Title = "Boat Owner Dashboard";
}

<div class="container py-4">

    <div class="hc-dashboard-header mb-4">
        <h2>&#128674; Boat Owner Dashboard</h2>
        <p class="text-muted">Welcome back, <strong>@Session["BoatOwnerName"]</strong></p>
    </div>

    @* Notification area: show items needing attention immediately after login *@
    @{
        var awaiting = ViewBag.AwaitingPaymentBoats as IEnumerable<APDP.Models.Boat> ?? Enumerable.Empty<APDP.Models.Boat>();
        var rejected = ViewBag.RejectedBoats as IEnumerable<APDP.Models.Boat> ?? Enumerable.Empty<APDP.Models.Boat>();
    }
    @if (awaiting.Any() || rejected.Any())
    {
        <div class="mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="mb-2">Notifications</h5>
                    <div class="list-group">
                        @foreach (var b in awaiting)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <strong>@b.BoatName</strong>
                                    <div class="small text-info">TNPA approved &mdash; registration fee required</div>
                                </div>
                                <div>
                                    @Html.ActionLink("Pay Now", "PayRegistrationFee", "BoatOwner", new { id = b.BoatID }, new { @class = "btn btn-sm btn-success" })
                                    <br />
                                    <small class="text-muted">Certificate will be issued after payment</small>
                                </div>
                            </div>
                        }

                        @foreach (var b in rejected)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <strong>@b.BoatName</strong>
                                    <div class="small text-danger">TNPA rejected &mdash; @Html.Raw(HttpUtility.HtmlEncode(b.RejectionReason ?? "No reason provided"))</div>
                                </div>
                                <div>
                                    @Html.ActionLink("Edit & Resubmit", "EditBoat", "BoatOwner", new { id = b.BoatID }, new { @class = "btn btn-sm btn-outline-primary" })
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }


    @* Stats Row *@
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-primary text-center p-3">
                <div class="hc-stat-number">@ViewBag.TotalBoats</div>
                <div class="hc-stat-label">Total Boats</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-success text-center p-3">
                <div class="hc-stat-number">@ViewBag.ApprovedBoats</div>
                <div class="hc-stat-label">Approved</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-warning text-center p-3">
                <div class="hc-stat-number">@ViewBag.PendingBoats</div>
                <div class="hc-stat-label">Pending Review</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-info text-center p-3">
                <div class="hc-stat-number">@ViewBag.TotalBookings</div>
                <div class="hc-stat-label">Total Bookings</div>
            </div>
        </div>
    </div>

    @* Navigation Cards *@
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3 d-flex flex-column">
                <h5>&#128674; My Boats</h5>
                <p class="text-muted small flex-grow-1">View and manage all your registered boats.</p>
                @Html.ActionLink("View My Boats", "MyBoats", "BoatOwner", null, new { @class = "btn btn-primary mt-auto" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3 d-flex flex-column">
                <h5>&#10133; Add New Boat</h5>
                <p class="text-muted small flex-grow-1">Submit a new boat for TNPA approval.</p>
                @Html.ActionLink("Add Boat", "AddBoat", "BoatOwner", null, new { @class = "btn btn-success mt-auto" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3 d-flex flex-column">
                <h5>&#128203; Bookings</h5>
                <p class="text-muted small flex-grow-1">View all customer bookings for your boats.</p>
                @Html.ActionLink("View Bookings", "Bookings", "BoatOwner", null, new { @class = "btn btn-info mt-auto" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3 d-flex flex-column">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <h5 class="mb-0">&#128663; Manage Drivers</h5>
                    @if (ViewBag.TotalDrivers != null && (int)ViewBag.TotalDrivers > 0)
                    {
                        <span class="badge bg-secondary">@ViewBag.TotalDrivers</span>
                    }
                </div>
                <p class="text-muted small flex-grow-1">
                    Add drivers, assign them to boats, and manage their login credentials.
                </p>
                @Html.ActionLink("Manage Drivers", "ManageDrivers", "BoatOwner", null, new { @class = "btn btn-warning mt-auto" })
            </div>
        </div>
    </div>

    <div class="mt-4">
        @Html.ActionLink("Logout", "Logout", "BoatOwner", null, new { @class = "btn btn-outline-danger" })
    </div>
</div>
