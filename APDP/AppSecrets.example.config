<?xml version="1.0" encoding="utf-8"?>
<!-- Local-only secrets. AppSecrets.config is git-ignored; never commit real keys. -->
<appSettings>
  <add key="OpenWeatherMapApiKey" value="your-openweathermap-key" />
  <add key="GeminiApiKey" value="your-gemini-key" />
  <add key="SeedDemoData" value="true" />

  <!-- Emails: fill in ONE of the two options, or leave EmailMode empty to switch emails off. -->
  <add key="EmailMode" value="" />
  <add key="EmailFrom" value="noreply@yourcompany.co.za" />
  <add key="SiteBaseUrl" value="https://localhost:44300" />

  <!-- Option 1 (recommended): Microsoft Graph app registration with Mail.Send -->
  <add key="GraphTenantId" value="" />
  <add key="GraphClientId" value="" />
  <add key="GraphClientSecret" value="" />

  <!-- Option 2: SMTP AUTH on the Microsoft 365 mailbox -->
  <add key="SmtpUser" value="noreply@yourcompany.co.za" />
  <add key="SmtpPassword" value="" />
</appSettings>
