@{
    ViewBag.Title = "Boat Owner Dashboard";
}

<div class="container py-4">

    <div class="hc-dashboard-header mb-4">
        <h2>&#128674; Boat Owner Dashboard</h2>
        <p class="text-muted">Welcome back, <strong>@Session["BoatOwnerName"]</strong></p>
    </div>

    @* Stats Row *@
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-primary text-center p-3">
                <div class="hc-stat-number">@ViewBag.TotalBoats</div>
                <div class="hc-stat-label">Total Boats</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-success text-center p-3">
                <div class="hc-stat-number">@ViewBag.ApprovedBoats</div>
                <div class="hc-stat-label">Approved</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-warning text-center p-3">
                <div class="hc-stat-number">@ViewBag.PendingBoats</div>
                <div class="hc-stat-label">Pending Review</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card hc-stat-card hc-stat-info text-center p-3">
                <div class="hc-stat-number">@ViewBag.TotalBookings</div>
                <div class="hc-stat-label">Total Bookings</div>
            </div>
        </div>
    </div>

    @* Navigation Cards *@
    <div class="row g-3">
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3">
                <h5>&#128674; My Boats</h5>
                <p class="text-muted small">View and manage all your registered boats.</p>
                @Html.ActionLink("View My Boats", "MyBoats", "BoatOwner", null, new { @class = "btn btn-primary mt-auto" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3">
                <h5>&#10133; Add New Boat</h5>
                <p class="text-muted small">Submit a new boat for TNPA approval.</p>
                @Html.ActionLink("Add Boat", "AddBoat", "BoatOwner", null, new { @class = "btn btn-success mt-auto" })
            </div>
        </div>
        <div class="col-md-4">
            <div class="card hc-card h-100 p-3">
                <h5>&#128203; Bookings</h5>
                <p class="text-muted small">View all customer bookings for your boats.</p>
                @Html.ActionLink("View Bookings", "Bookings", "BoatOwner", null, new { @class = "btn btn-info mt-auto" })
            </div>
        </div>
    </div>

    <div class="mt-4">
        @Html.ActionLink("Logout", "Logout", "BoatOwner", null, new { @class = "btn btn-outline-danger" })
    </div>
</div>
