@model IEnumerable<APDP.Models.BoatUnavailableDate>
@{
    ViewBag.Title = "Manage Availability";
    var boat = ViewBag.Boat as APDP.Models.Boat;
}

<div class="container py-4">
    <h3>Manage Availability &mdash; @boat.BoatName</h3>

    <div class="card p-3 mb-3">
        @using (Html.BeginForm("AddUnavailableDate", "BoatOwner", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("boatId", boat.BoatID)
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Date</label>
                    <input type="date" name="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Reason (optional)</label>
                    <input type="text" name="reason" class="form-control" maxlength="250" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100">Add</button>
                </div>
            </div>
        }
    </div>

    <div class="card">
        <div class="card-header">Upcoming Unavailable Dates</div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="text-muted">No unavailable dates set.</div>
            }
            else
            {
                <ul class="list-group">
                    @foreach (var u in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <strong>@u.Date.ToString("dd MMM yyyy")</strong>
                                @if (!string.IsNullOrEmpty(u.Reason))
                                {
                                    <div class="small text-muted">@u.Reason</div>
                                }
                            </div>
                            @using (Html.BeginForm("RemoveUnavailableDate", "BoatOwner", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("id", u.UnavailableDateID)
                                <button class="btn btn-outline-danger btn-sm">Remove</button>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("Back to My Boats", "MyBoats", "BoatOwner", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>