        .hc-upload-zone-hover     { border-color:#1565c0; background:#f0f4ff; }

        /* ── Thumbnail grid ─────────────────────────────────────── */
        .hc-thumb-wrap            { position:relative; width:160px; }
        .hc-thumb-img             { width:160px; height:120px; object-fit:cover; border-radius:8px; border:2px solid #e0e0e0; display:block; }
        video.hc-thumb-img        { object-fit:contain; background:#000; }
