@model IEnumerable<APDP.Models.Boat>
@{
    ViewBag.Title = "All Registered Boats";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2>&#128674; All Registered Boats</h2>
        @Html.ActionLink("Back to Dashboard", "Dashboard", "Tnpa", null, new { @class = "btn btn-outline-secondary" })
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h5>No boats registered yet.</h5>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover hc-table align-middle">
                <thead>
                    <tr>
                        <th>Boat Name</th>
                        <th>Type</th>
                        <th>Registration</th>
                        <th>Location</th>
                        <th>Owner</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var boat in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@boat.BoatName</td>
                            <td>@boat.BoatType</td>
                            <td><code>@boat.RegistrationNumber</code></td>
                            <td>@boat.HarbourLocation</td>
                            <td>@boat.BoatOwner.FullName</td>
                            <td>R @boat.PriceAdult.ToString("N2")/hr &nbsp;|&nbsp; R @boat.PriceChild.ToString("N2")/hr</td>
                            <td>
                                @if (boat.Status == APDP.Models.BoatStatus.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.AwaitingPayment)
                                {
                                    <span class="badge bg-info text-dark">Awaiting Payment</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Inactive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Removed)
                                {
                                    <span class="badge bg-dark">Removed</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center flex-wrap">
                                    @Html.ActionLink("Details", "BoatDetails", "Tnpa",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-primary" })

                                    @* Remove button - triggers the modal for this boat *@
                                    @if (boat.Status != APDP.Models.BoatStatus.Removed)
                                    {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            onclick="openRemoveModal(@boat.BoatID, '@Html.Raw(boat.BoatName.Replace("'", "\\'"))')">
                                        &#128465; Remove
                                    </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* ══════════════════════════════════════════════════════════════
   REMOVE BOAT MODAL
   ══════════════════════════════════════════════════════════════ *@
<div class="modal fade" id="removeBoatModal" tabindex="-1" aria-labelledby="removeBoatModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">

            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="removeBoatModalLabel">&#128465; Remove Boat</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="alert alert-danger d-flex gap-2 align-items-start">
                    <span style="font-size:1.4rem;">&#9888;</span>
                    <div>
                        <strong>This takes the boat off the platform.</strong><br />
                        Removing <strong id="removeBoatName"></strong> hides it from customers, cancels its
                        upcoming trips (customers and the owner are notified) and unassigns its drivers.
                        Past bookings and ratings are kept on record.
                    </div>
                </div>

                @using (Html.BeginForm("RemoveBoat", "Tnpa", FormMethod.Post, new { id = "removeBoatForm" }))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="removeBoatId" value="" />

                    <div class="mb-3">
                        <label for="removalReason" class="form-label fw-semibold">
                            Reason for Removal <span class="text-danger">*</span>
                        </label>
                        <textarea name="removalReason" id="removalReason" class="form-control" rows="4"
                                  placeholder="Explain why this boat is being permanently removed (e.g. fraudulent listing, safety violation, owner request)..."
                                  required></textarea>
                        <div class="form-text text-muted">This reason is recorded for audit purposes.</div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="btn btn-danger fw-semibold" id="confirmRemoveBtn">
                            &#128465; Yes, Remove Permanently
                        </button>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
        function openRemoveModal(boatId, boatName) {
            document.getElementById('removeBoatId').value   = boatId;
            document.getElementById('removeBoatName').textContent = boatName;
            document.getElementById('removalReason').value = '';

            var modal = new bootstrap.Modal(document.getElementById('removeBoatModal'));
            modal.show();
        }

        // Prevent double-submit: disable the button once the form is submitted
        document.getElementById('removeBoatForm').addEventListener('submit', function (e) {
            var reason = document.getElementById('removalReason').value.trim();
            if (!reason) {
                e.preventDefault();
                document.getElementById('removalReason').focus();
                return;
            }
            var btn = document.getElementById('confirmRemoveBtn');
            btn.disabled   = true;
            btn.textContent = 'Removing...';
        });
    </script>
}
