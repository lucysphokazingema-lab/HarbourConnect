@model IEnumerable<APDP.Models.Booking>
@{
    ViewBag.Title = "My Bookings";
    var unrated = Model.Where(b => b.Status == APDP.Models.BookingStatus.Completed && !b.IsRated).ToList();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📋 My Bookings</h2>
        @Html.ActionLink("Browse Boats", "Boats", "Customer", null, new { @class = "btn btn-success" })
    </div>

    @* Rate prompt banner *@
    @if (unrated.Any())
    {
        <div class="alert alert-warning d-flex align-items-center gap-3 mb-4" role="alert">
            <span style="font-size:2rem;">⭐</span>
            <div>
                <strong>How was your trip?</strong>
                You have <strong>@unrated.Count</strong> completed @(unrated.Count == 1 ? "trip" : "trips") waiting for your rating.
                Scroll down to rate and help other customers.
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h5>No bookings yet.</h5>
            <p class="mb-3">Start by browsing the available boats.</p>
            @Html.ActionLink("Browse Available Boats", "Boats", "Customer", null, new { @class = "btn btn-success" })
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var booking in Model)
            {
                bool needsRating = booking.Status == APDP.Models.BookingStatus.Completed && !booking.IsRated;

                <div class="col-md-6">
                    <div class="card hc-card h-100 @(needsRating ? "hc-card-rate-prompt" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title">🚢 @booking.Boat.BoatName</h5>
                                @if (booking.Status == APDP.Models.BookingStatus.Confirmed)
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else if (booking.Status == APDP.Models.BookingStatus.Cancelled)
                                {
                                    <span class="badge bg-danger">Cancelled</span>
                                }
                                else if (booking.Status == APDP.Models.BookingStatus.Completed)
                                {
                                    <span class="badge bg-secondary">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Awaiting payment</span>
                                }
                            </div>

                            <p class="text-muted small mb-1">
                                <strong>Location:</strong> @booking.Boat.HarbourLocation
                            </p>
                            <p class="text-muted small mb-1">
                                <strong>Trip Date:</strong> @booking.TripDate.ToString("dddd, dd MMMM yyyy")
                            </p>
                            <p class="text-muted small mb-1">
                                <strong>Time:</strong> @booking.TripStartTime.ToString(@"hh\:mm") (@booking.TripDurationHours h)
                            </p>
                            <p class="text-muted small mb-1">
                                <strong>Passengers:</strong>
                                @booking.NumberOfPassengers adult@(booking.NumberOfPassengers == 1 ? "" : "s")@(booking.ChildPassengers > 0 ? ", " + booking.ChildPassengers + (booking.ChildPassengers == 1 ? " child" : " children") : "")
                            </p>
                            @if (!string.IsNullOrEmpty(booking.SpecialRequests))
                            {
                                <p class="text-muted small mb-1">
                                    <strong>Special Requests:</strong> @booking.SpecialRequests
                                </p>
                            }
                            @if (!string.IsNullOrEmpty(booking.SelectedExtras))
                            {
                                <p class="text-muted small mb-1">
                                    <strong>Extras:</strong> @booking.SelectedExtras
                                </p>
                            }
                            <p class="text-muted small mb-1">
                                <strong>Booked:</strong> @booking.BookingDate.ToString("dd MMM yyyy")
                            </p>

                            @if (booking.RideStartedAt.HasValue)
                            {
                                <p class="text-muted small mb-1">
                                    <strong>Ride Started:</strong> @booking.RideStartedAt.Value.ToString("dd MMM yyyy HH:mm")
                                </p>
                            }
                            @if (booking.RideEndedAt.HasValue)
                            {
                                <p class="text-muted small mb-1">
                                    <strong>Ride Ended:</strong> @booking.RideEndedAt.Value.ToString("dd MMM yyyy HH:mm")
                                </p>
                            }

                            <p class="hc-price-tag mt-2 mb-0">
                                Total: R @booking.TotalPrice.ToString("N2")
                            </p>

                            @* Already rated - show stars *@
                            @if (booking.Status == APDP.Models.BookingStatus.Completed && booking.IsRated)
                            {
                                <div class="mt-2 text-warning small">
                                    ⭐ You rated this trip — thank you!
                                </div>
                            }

                            @* Pay button for unpaid bookings *@
                            @if (booking.Status == APDP.Models.BookingStatus.Pending)
                            {
                                <div class="mt-3">
                                    @Html.ActionLink("💳 Pay now", "PayBooking", "Customer",
                                        new { id = booking.BookingID },
                                        new { @class = "btn btn-success btn-sm w-100 fw-semibold" })
                                </div>
                            }

                            @* Cancel button *@
                            @if (booking.Status == APDP.Models.BookingStatus.Pending ||
                                 (booking.Status == APDP.Models.BookingStatus.Confirmed &&
                                  booking.TripDate.Add(booking.TripStartTime) > DateTime.Now.AddDays(1)))
                            {
                                <div class="mt-3">
                                    @using (Html.BeginForm("CancelBooking", "Customer", new { id = booking.BookingID }, FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Cancel this booking?')">
                                            Cancel Booking
                                        </button>
                                    }
                                </div>
                            }

                            @* Rate button for completed unrated trips *@
                            @if (needsRating)
                            {
                                <div class="mt-3">
                                    @Html.ActionLink("⭐ Rate This Trip", "RateBoat", "Customer",
                                        new { bookingId = booking.BookingID },
                                        new { @class = "btn btn-warning btn-sm w-100 fw-semibold" })
                                </div>
                            }

                            @* QR / Slip button for confirmed bookings *@
                            @if (booking.Status == APDP.Models.BookingStatus.Confirmed ||
                                 booking.Status == APDP.Models.BookingStatus.Completed)
                            {
                                <div class="mt-2">
                                    @Html.ActionLink("📷 View QR Slip", "BookingConfirmation", "Customer",
                                        new { id = booking.BookingID },
                                        new { @class = "btn btn-outline-primary btn-sm w-100" })
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        @Html.ActionLink("Back to Dashboard", "Dashboard", "Customer", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<style>
    .hc-card-rate-prompt {
        border: 2px solid #f9a825 !important;
        box-shadow: 0 0 0 3px rgba(249,168,37,0.15) !important;
    }
</style>
