@{
    ViewBag.Title = "Customer Dashboard";
}

@* ── Hero Section ─────────────────────────────────────────────── *@
<div class="hc-hero">
    @* Left panel — search & welcome *@
    <div class="hc-hero-panel">
        <h1 class="hc-hero-title">Find Your Perfect<br>Harbour Adventure</h1>
        <p class="hc-hero-sub">Welcome back, <strong>@Session["CustomerName"]</strong></p>

        <div class="hc-hero-form">
            @using (Html.BeginForm("Boats", "Customer", FormMethod.Get))
            {
                <div class="hc-search-field">
                    <span class="hc-search-icon">&#128205;</span>
                    <select name="boatType" class="hc-search-input">
                        <option value="">All Boat Types</option>
                        <option value="Fishing Boat">Fishing Boat</option>
                        <option value="Leisure Cruiser">Leisure Cruiser</option>
                        <option value="Speed Boat">Speed Boat</option>
                        <option value="Yacht">Yacht</option>
                        <option value="Catamaran">Catamaran</option>
                        <option value="Party Boat">Party Boat</option>
                    </select>
                </div>

                <div class="hc-search-field">
                    <span class="hc-search-icon">&#128269;</span>
                    <input type="text" name="searchName" class="hc-search-input"
                           placeholder="Search boat name..." autocomplete="off" />
                </div>

                <div class="hc-type-btns">
                    <button type="submit" name="sortPrice" value="asc"  class="hc-type-btn">Low Price</button>
                    <button type="submit" name="sortPrice" value="desc" class="hc-type-btn">High Price</button>
                </div>

                <button type="submit" class="hc-search-btn">Search Boats</button>
            }
        </div>

        @* Stats row *@
        <div class="hc-hero-stats">
            <div class="hc-hero-stat">
                <span class="hc-hero-stat-num">@ViewBag.AvailableBoats</span>
                <span class="hc-hero-stat-lbl">Available Boats</span>
            </div>
            <div class="hc-hero-stat-divider"></div>
            <div class="hc-hero-stat">
                <span class="hc-hero-stat-num">@ViewBag.TotalBookings</span>
                <span class="hc-hero-stat-lbl">My Bookings</span>
            </div>
            <div class="hc-hero-stat-divider"></div>
            <div class="hc-hero-stat">
                <span class="hc-hero-stat-num">@ViewBag.UnratedTrips</span>
                <span class="hc-hero-stat-lbl">To Rate</span>
            </div>
        </div>
    </div>

    @* Right side — background image *@
    <div class="hc-hero-image"></div>
</div>

@* ── Quick Action Cards ───────────────────────────────────────── *@
<div class="container py-4">
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card hc-card p-4 h-100">
                <h5>Browse Available Boats</h5>
                <p class="text-muted">Explore TNPA-approved boats and plan your harbour trip.</p>
                @Html.ActionLink("Browse Boats", "Boats", "Customer", null, new { @class = "btn btn-success" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="card hc-card p-4 h-100">
                <h5>My Bookings</h5>
                <p class="text-muted">View and manage all your trip bookings.</p>
                @Html.ActionLink("View My Bookings", "MyBookings", "Customer", null, new { @class = "btn btn-info" })
            </div>
        </div>
    </div>

    @* Durban Harbour Map *@
    <div class="card hc-card mt-4">
        <div class="card-body p-4">
            <h5 class="mb-1">&#128205; Durban Harbour Location</h5>
            <p class="text-muted small mb-3">All boat trips depart from the Durban Harbour, Point Waterfront, Durban, KwaZulu-Natal.</p>
            <div class="ratio ratio-16x9" style="border-radius:10px; overflow:hidden;">
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3460.2!2d31.0292!3d-29.8681!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1ef7a9127b8aad3b%3A0x8f1f3e2a1e3e1e3e!2sDurban%20Harbour!5e0!3m2!1sen!2sza!4v1690000000000!5m2!1sen!2sza"
                    width="600" height="450" style="border:0;"
                    allowfullscreen="" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Durban Harbour Map">
                </iframe>
            </div>
            <div class="mt-3 d-flex align-items-center gap-2">
                <span class="badge bg-primary">&#9875; Departure Point</span>
                <span class="text-muted small">Point Waterfront, Durban, 4001, KwaZulu-Natal, South Africa</span>
            </div>
        </div>
    </div>

    <div class="mt-4">
        @Html.ActionLink("Logout", "Logout", "Customer", null, new { @class = "btn btn-outline-danger" })
    </div>
</div>

<style>
    /* ── Hero: rounded card, search left, harbour photo right ── */
    .hc-hero {
        display: flex;
        min-height: 480px;
        max-width: 1296px;
        margin: 24px auto 0;
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius);
        box-shadow: var(--hc-shadow);
        overflow: hidden;
    }
    @@media (max-width: 1320px) {
        .hc-hero { margin-left: 12px; margin-right: 12px; }
    }

    /* ── Left panel ───────────────────────────────────── */
    .hc-hero-panel {
        width: 44%;
        padding: 44px 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .hc-hero-title {
        font-size: 2rem;
        font-weight: 800;
        color: var(--hc-heading);
        line-height: 1.2;
        letter-spacing: -0.02em;
        margin-bottom: 6px;
    }

    .hc-hero-sub {
        color: var(--hc-text-muted);
        margin-bottom: 24px;
        font-size: 1rem;
    }
    .hc-hero-sub strong { color: var(--hc-heading); }

    /* ── Search form ──────────────────────────────────── */
    /* Html.BeginForm wraps the fields in <form>, so the gap belongs on the form itself */
    .hc-hero-form { margin-bottom: 24px; }
    .hc-hero-form form {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin: 0;
    }

    .hc-search-field {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--hc-border-strong);
        border-radius: var(--hc-radius-sm);
        padding: 0 14px;
        background: var(--hc-surface-2);
        height: 48px;
        transition: border-color 0.15s, box-shadow 0.15s;
    }
    .hc-search-field:focus-within {
        border-color: var(--hc-primary);
        box-shadow: var(--hc-focus-ring);
    }

    .hc-search-icon {
        font-size: 1rem;
        line-height: 1;
        flex-shrink: 0;
    }

    .hc-search-input {
        flex: 1;
        min-width: 0;
        height: 100%;
        border: none;
        background: transparent;
        outline: none;
        font-size: 0.95rem;
        color: var(--hc-text);
        padding: 0;
    }
    .hc-search-input::placeholder { color: var(--hc-text-muted); }
    .hc-search-input option { background: var(--hc-surface); color: var(--hc-text); }

    .hc-type-btns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .hc-type-btn {
        height: 44px;
        border: 1px solid var(--hc-border-strong);
        border-radius: var(--hc-radius-sm);
        background: var(--hc-surface);
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--hc-text);
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .hc-type-btn:hover {
        background: var(--hc-primary-soft);
        border-color: var(--hc-primary);
        color: var(--hc-primary);
    }

    .hc-search-btn {
        height: 48px;
        background: var(--hc-primary);
        color: var(--hc-on-primary);
        border: none;
        border-radius: var(--hc-radius-sm);
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.15s;
    }
    .hc-search-btn:hover { background: var(--hc-primary-hover); }

    .hc-type-btn:focus-visible,
    .hc-search-btn:focus-visible { outline: none; box-shadow: var(--hc-focus-ring); }

    /* ── Stats row ────────────────────────────────────── */
    .hc-hero-stats {
        display: flex;
        align-items: center;
        gap: 16px;
        background: var(--hc-surface-2);
        border: 1px solid var(--hc-border);
        border-radius: 12px;
        padding: 16px 20px;
    }

    .hc-hero-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1;
    }

    .hc-hero-stat-num {
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--hc-heading);
        line-height: 1;
    }

    .hc-hero-stat-lbl {
        font-size: 0.75rem;
        color: var(--hc-text-muted);
        text-align: center;
        margin-top: 4px;
    }

    .hc-hero-stat-divider {
        width: 1px;
        height: 36px;
        background: var(--hc-border);
    }

    /* ── Right image panel ────────────────────────────── */
    .hc-hero-image {
        flex: 1;
        background: linear-gradient(135deg, #0a3d6b 0%, #1565c0 50%, #0288d1 100%);
        background-image: url('/Content/hero-bg.jpg');
        background-size: cover;
        background-position: center;
    }

    /* ── Responsive ───────────────────────────────────── */
    @@media (max-width: 768px) {
        .hc-hero { flex-direction: column; }
        .hc-hero-panel { width: 100%; padding: 28px 20px; }
        .hc-hero-image { min-height: 200px; }
        .hc-hero-title { font-size: 1.5rem; }
    }
</style>
