@model APDP.Models.Booking
@{
    ViewBag.Title = "Booking Confirmed";

    // QR content is kept minimal (no phone/email) and rendered in the browser
    // by Scripts/qrcode.min.js, so booking data is never sent to a third party.
    string qrText =
        "HARBOURCONNECT BOOKING #" + Model.BookingID + "\n" +
        "Status: " + Model.Status + "\n" +
        "Customer: " + Model.Customer.FullName + "\n" +
        "Boat: " + Model.Boat.BoatName + " (" + Model.Boat.RegistrationNumber + ")\n" +
        "Trip: " + Model.TripDate.ToString("dd MMM yyyy") + " " + Model.TripStartTime.ToString(@"hh\:mm") +
        " for " + Model.TripDurationHours + "h\n" +
        "Passengers: " + Model.NumberOfPassengers + " adult(s), " + Model.ChildPassengers + " child(ren)";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @* Success banner *@
            <div class="alert alert-success d-flex align-items-center gap-3 mb-4">
                <span style="font-size:2.5rem;">&#9989;</span>
                <div>
                    <h5 class="mb-0 fw-bold">Booking Confirmed!</h5>
                    <p class="mb-0 small">Your trip has been successfully booked. Save or print this confirmation slip.</p>
                </div>
            </div>

            @* Booking Slip Card *@
            <div class="card hc-slip-card" id="bookingSlip">

                @* Slip Header *@
                <div class="hc-slip-header">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h3 class="mb-0 fw-bold">&#9875; HarbourConnect</h3>
                            <div class="hc-slip-sub">Booking Confirmation Slip</div>
                        </div>
                        <div class="text-end">
                            <div class="hc-slip-booking-id">#@Model.BookingID</div>
                            <span class="badge bg-success px-3 py-2 fs-6">CONFIRMED</span>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row g-4">

                        @* Left column - booking details *@
                        <div class="col-md-7">

                            @* Customer *@
                            <div class="hc-slip-section">
                                <div class="hc-slip-section-title">&#128100; Customer</div>
                                <table class="table table-sm hc-slip-table">
                                    <tr><th>Name</th><td>@Model.Customer.FullName</td></tr>
                                    <tr><th>Phone</th><td>@Model.Customer.PhoneNumber</td></tr>
                                    <tr><th>Email</th><td>@Model.Customer.Email</td></tr>
                                </table>
                            </div>

                            @* Boat *@
                            <div class="hc-slip-section">
                                <div class="hc-slip-section-title">&#128674; Boat</div>
                                <table class="table table-sm hc-slip-table">
                                    <tr><th>Boat Name</th><td><strong>@Model.Boat.BoatName</strong></td></tr>
                                    <tr><th>Reg. Number</th><td><code>@Model.Boat.RegistrationNumber</code></td></tr>
                                    <tr><th>Type</th><td>@Model.Boat.BoatType</td></tr>
                                    <tr><th>Location</th><td>@Model.Boat.HarbourLocation</td></tr>
                                    <tr><th>Owner</th><td>@Model.Boat.BoatOwner.BusinessName</td></tr>
                                    <tr><th>Owner Phone</th><td>@Model.Boat.BoatOwner.PhoneNumber</td></tr>
                                </table>
                            </div>

                            @* Trip & Payment *@
                            <div class="hc-slip-section">
                                <div class="hc-slip-section-title">&#128197; Trip &amp; Payment</div>
                                <table class="table table-sm hc-slip-table">
                                    <tr><th>Trip Date</th><td><strong>@Model.TripDate.ToString("dddd, dd MMMM yyyy")</strong></td></tr>
                                    <tr><th>Start Time</th><td><strong>@Model.TripStartTime.ToString(@"hh\:mm")</strong> (@Model.TripDurationHours h)</td></tr>
                                    <tr>
                                        <th>Passengers</th>
                                        <td>
                                            @Model.NumberOfPassengers adult@(Model.NumberOfPassengers == 1 ? "" : "s")
                                            @if (Model.ChildPassengers > 0)
                                            {
                                                <text>, @Model.ChildPassengers child@(Model.ChildPassengers == 1 ? "" : "ren")</text>
                                            }
                                        </td>
                                    </tr>
                                    <tr><th>Booked On</th><td>@Model.BookingDate.ToString("dd MMM yyyy") at @Model.BookingDate.ToString("HH:mm")</td></tr>
                                    @if (!string.IsNullOrEmpty(Model.SpecialRequests))
                                    {
                                        <tr><th>Special Requests</th><td>@Model.SpecialRequests</td></tr>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.SelectedExtras))
                                    {
                                        <tr>
                                            <th>Extras Selected</th>
                                            <td>@Model.SelectedExtras</td>
                                        </tr>
                                        <tr>
                                            <th>Extras Total</th>
                                            <td>R @Model.ExtrasTotal.ToString("N2")</td>
                                        </tr>
                                    }
                                    <tr class="hc-slip-total">
                                        <th>Amount Paid</th>
                                        <td><strong class="text-success fs-5">R @Model.TotalPrice.ToString("N2")</strong></td>
                                    </tr>
                                    <tr><th>Payment Status</th><td><span class="badge bg-success">Paid in Full</span></td></tr>
                                </table>
                            </div>

                        </div>

                        @* Right column - QR code *@
                        <div class="col-md-5 d-flex flex-column align-items-center justify-content-start">
                            <div class="hc-qr-container">
                                <div class="hc-qr-label">&#128247; Scan to Verify Booking</div>
                                <div id="qrcode" data-qr="@qrText"
                                     style="border-radius:8px; border:3px solid #0d2c54; padding:6px; background:#fff; display:inline-block;"></div>
                                <div class="hc-qr-sublabel mt-2">
                                    Booking #@Model.BookingID &bull; @Model.Boat.BoatName<br />
                                    @Model.TripDate.ToString("dd MMM yyyy") &bull; R @Model.TotalPrice.ToString("N2")
                                </div>
                            </div>

                            <div class="mt-3 text-center">
                                <div class="hc-qr-note">
                                    &#9432; Show this QR code to the driver on the day of your trip.
                                </div>
                            </div>
                        </div>

                    </div>

                    @* Footer note *@
                    <div class="hc-slip-footer mt-3">
                        &#9432; Please show this QR code to the driver or boat owner on the day of your trip.
                        The driver will scan it to verify your booking before starting the ride.
                    </div>

                </div>
            </div>

            @* Action buttons *@
            <div class="d-flex gap-3 mt-4 flex-wrap">
                <button class="btn btn-primary btn-lg" onclick="window.print()">
                    Print / Save as PDF
                </button>
                @Html.ActionLink("View All Bookings", "MyBookings", "Customer", null,
                    new { @class = "btn btn-outline-secondary btn-lg" })
                @Html.ActionLink("Browse More Boats", "Boats", "Customer", null,
                    new { @class = "btn btn-outline-success btn-lg" })
            </div>

        </div>
    </div>
</div>

<style>
    .hc-slip-card          { border: 2px solid var(--hc-border); border-radius: var(--hc-radius); overflow: hidden; box-shadow: var(--hc-shadow); }
    .hc-slip-header        { background: var(--hc-header-bg); color: #fff; padding: 24px 28px; }
    .hc-slip-sub           { font-size: 0.85rem; opacity: 0.85; margin-top: 2px; }
    .hc-slip-booking-id    { font-size: 1.5rem; font-weight: 800; letter-spacing: 1px; }
    .hc-slip-section       { margin-bottom: 18px; }
    .hc-slip-section-title { font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.8px; color: var(--hc-primary); border-bottom: 1px solid var(--hc-border); padding-bottom: 4px; margin-bottom: 8px; }
    .hc-slip-table th      { font-weight: 600; color: var(--hc-text-muted); width: 38%; font-size: 0.82rem; }
    .hc-slip-table td      { font-size: 0.85rem; color: var(--hc-text); }
    .hc-slip-total th,
    .hc-slip-total td      { padding-top: 10px; border-top: 2px solid var(--hc-primary); }
    .hc-qr-container       { background: var(--hc-surface-2); border: 2px solid var(--hc-border); border-radius: 12px; padding: 16px 20px; text-align: center; }
    .hc-qr-label           { font-weight: 700; font-size: 0.82rem; color: var(--hc-heading); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; }
    #qrcode                { display: inline-block; }
    #qrcode img            { border-radius: 6px; }
    .hc-qr-sublabel        { font-size: 0.72rem; color: var(--hc-text-muted); margin-top: 10px; line-height: 1.5; }
    .hc-qr-note        { background: var(--hc-info-soft); border: 1px solid var(--hc-border); border-radius: 8px; padding: 10px 14px; font-size: 0.82rem; color: var(--hc-text); }
    .hc-slip-footer        { background: var(--hc-warning-soft); border: 1px solid var(--hc-border); border-radius: 8px; padding: 10px 14px; font-size: 0.82rem; color: var(--hc-text); }
</style>

@* Print styles live in Site.css to avoid Razor parsing @media as code *@

@section scripts {
    <script src="@Url.Content("~/Scripts/qrcode.min.js")"></script>
    <script>
        (function () {
            var el = document.getElementById('qrcode');
            if (!el || typeof QRCode === 'undefined') return;
            new QRCode(el, {
                text: el.getAttribute('data-qr'),
                width: 208, height: 208,
                correctLevel: QRCode.CorrectLevel.M
            });
        })();
    </script>
}
