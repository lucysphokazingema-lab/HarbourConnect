        .hc-tile-cb              { width:1.3rem; height:1.3rem; flex-shrink:0; cursor:pointer; accent-color:#2e7d32; }
        .hc-tile-body            { display:flex; align-items:center; gap:10px; }
        .hc-tile-icon            { font-size:1.6rem; line-height:1; }
