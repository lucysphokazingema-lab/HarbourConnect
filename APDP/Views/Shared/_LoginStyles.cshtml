<style>
    /* ── Remove default page padding for login ───────────── */
    .hc-main-content { padding: 0 !important; }

    /* ── Outer wrapper ───────────────────────────────────── */
    .lp-wrapper {
        display: flex;
        min-height: calc(100vh - 60px);
    }

    /* ── Left image panel ────────────────────────────────── */
    .lp-left {
        width: 45%;
        position: relative;
        background-image: url('/Content/login-bg.jpg');
        background-size: cover;
        background-position: center;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px 36px;
        overflow: hidden;
    }

    /* Lighter overlay so the photo is brighter/more visible */
    .lp-left-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(170deg, rgba(5,20,60,0.28) 0%, rgba(5,15,45,0.55) 100%);
    }

    .lp-left-top,
    .lp-left-bottom {
        position: relative;
        z-index: 2;
        color: #fff;
    }

    /* Logo + brand at the top */
    .lp-left-top { display: flex; flex-direction: column; gap: 4px; }

    .lp-logo-icon {
        font-size: 2.6rem;
        line-height: 1;
        filter: drop-shadow(0 2px 6px rgba(0,0,0,0.4));
    }

    .lp-brand {
        font-size: 1.75rem;
        font-weight: 800;
        margin: 6px 0 4px 0;
        letter-spacing: -0.3px;
        color: #fff;
        text-shadow: 0 2px 8px rgba(0,0,0,0.35);
    }

    .lp-tagline {
        font-size: 0.88rem;
        opacity: 0.9;
        margin: 0;
        text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    }

    /* Tagline at the bottom */
    .lp-left-bottom .lp-hero-text {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0 0 4px 0;
        text-shadow: 0 2px 8px rgba(0,0,0,0.4);
    }

    .lp-left-bottom .lp-hero-sub {
        font-size: 0.82rem;
        opacity: 0.85;
        margin: 0;
        text-shadow: 0 1px 4px rgba(0,0,0,0.4);
    }

    /* ── Right form panel ────────────────────────────────── */
    .lp-right {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 32px;
        background: var(--hc-bg);
    }

    .lp-form-box {
        width: 100%;
        max-width: 400px;
        background: var(--hc-surface);
        border: 1px solid var(--hc-border);
        border-radius: var(--hc-radius);
        padding: 40px 36px;
        box-shadow: var(--hc-shadow);
    }

    /* Title */
    .lp-form-title {
        font-size: 1.5rem;
        font-weight: 800;
        color: var(--hc-heading);
        margin: 0 0 4px 0;
    }

    .lp-form-sub {
        font-size: 0.88rem;
        color: var(--hc-text-muted);
        margin-bottom: 28px;
    }

    /* ── Fields ──────────────────────────────────────────── */
    .lp-field {
        display: flex;
        align-items: center;
        border: 1.5px solid var(--hc-border-strong);
        border-radius: var(--hc-radius-sm);
        padding: 0 16px;
        margin-bottom: 16px;
        height: 54px;
        background: var(--hc-surface-2);
        transition: border-color 0.18s, box-shadow 0.18s;
    }

    .lp-field:focus-within {
        border-color: var(--hc-primary);
        background: var(--hc-surface);
        box-shadow: var(--hc-focus-ring);
    }

    .lp-field-icon {
        font-size: 1rem;
        margin-right: 10px;
        color: var(--hc-text-muted);
        flex-shrink: 0;
    }

    .lp-input {
        border: none;
        background: transparent;
        outline: none;
        flex: 1;
        font-size: 0.93rem;
        color: var(--hc-text);
    }

    .lp-input::placeholder { color: var(--hc-text-muted); opacity: 0.8; }

    .lp-toggle-pass {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--hc-text-muted);
        font-size: 0.95rem;
        padding: 0;
        line-height: 1;
        transition: color 0.15s;
    }

    .lp-toggle-pass:hover { color: var(--hc-text); }

    /* ── Remember / forgot row ───────────────────────────── */
    .lp-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        font-size: 0.83rem;
    }

    .lp-remember { display: flex; align-items: center; gap: 6px; color: var(--hc-text-muted); cursor: pointer; }
    .lp-remember input { accent-color: var(--hc-primary); width: 14px; height: 14px; cursor: pointer; }

    /* ── Login button ────────────────────────────────────── */
    .lp-btn-primary {
        display: block;
        width: 100%;
        padding: 15px;
        background: var(--hc-primary);
        color: var(--hc-on-primary);
        border: none;
        border-radius: var(--hc-radius-sm);
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.1s;
        text-align: center;
        letter-spacing: 0.03em;
    }

    .lp-btn-primary:hover  { background: var(--hc-primary-hover); transform: translateY(-1px); }
    .lp-btn-primary:active { transform: translateY(0); }

    /* ── Divider ─────────────────────────────────────────── */
    .lp-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 20px 0;
        color: var(--hc-text-muted);
        font-size: 0.8rem;
    }

    .lp-divider::before,
    .lp-divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--hc-border);
    }

    /* ── Secondary / outline button ─────────────────────── */
    .lp-btn-outline {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 13px;
        border: 1.5px solid var(--hc-border-strong);
        border-radius: var(--hc-radius-sm);
        text-align: center;
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--hc-text);
        text-decoration: none;
        background: var(--hc-surface);
        transition: border-color 0.18s, background 0.18s, color 0.18s;
    }

    .lp-btn-outline:hover { border-color: var(--hc-primary); color: var(--hc-primary); background: var(--hc-primary-soft); }

    /* ── Footer note ─────────────────────────────────────── */
    .lp-footer-note {
        text-align: center;
        font-size: 0.8rem;
        color: var(--hc-text-muted);
        margin-top: 22px;
    }

    .lp-footer-note a { color: var(--hc-primary); text-decoration: none; font-weight: 500; }
    .lp-footer-note a:hover { text-decoration: underline; }

    /* ── Responsive ──────────────────────────────────────── */
    @@media (max-width: 768px) {
        .lp-wrapper    { flex-direction: column; }
        .lp-left       { width: 100%; min-height: 220px; padding: 28px 24px; }
        .lp-left-bottom { display: none; }
        .lp-right      { padding: 32px 20px; }
    }
</style>
