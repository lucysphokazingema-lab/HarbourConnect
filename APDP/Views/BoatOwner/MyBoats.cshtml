@model IEnumerable<APDP.Models.Boat>
@{
    ViewBag.Title = "My Boats";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="hc-page-title">&#128674; My Boats</h2>
        @Html.ActionLink("+ Add New Boat", "AddBoat", "BoatOwner", null, new { @class = "btn btn-success" })
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h5>No boats registered yet.</h5>
            <p class="mb-3">Add your first boat to get started.</p>
            @Html.ActionLink("Add Your First Boat", "AddBoat", "BoatOwner", null, new { @class = "btn btn-primary" })
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover hc-table align-middle" style="min-width:900px;">
                <thead>
                    <tr>
                        <th style="white-space:nowrap;">Reg. Number (Primary Key)</th>
                        <th style="white-space:nowrap;">Boat Name</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Price</th>
                        <th style="white-space:nowrap;">Max Pax</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var boat in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark fs-6 px-2 py-1">@boat.RegistrationNumber</span></td>
                            <td class="fw-semibold">@boat.BoatName</td>
                            <td>@boat.BoatType</td>
                            <td>@boat.HarbourLocation</td>
                            <td>R @boat.PricePerTrip.ToString("N2")</td>
                            <td>@boat.MaxPassengers</td>
                            <td>
                                @if (boat.TotalRatings > 0)
                                {
                                    <span class="text-warning">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= Math.Round(boat.AverageRating))
                                            { <text>&#9733;</text> }
                                            else
                                            { <text>&#9734;</text> }
                                        }
                                    </span>
                                    <br /><small class="text-muted">@boat.AverageRating.ToString("0.0") (@boat.TotalRatings)</small>
                                }
                                else
                                {
                                    <small class="text-muted">No ratings yet</small>
                                }
                            </td>
                            <td>
                                @if (boat.Status == APDP.Models.BoatStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending Review</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                    if (!string.IsNullOrEmpty(boat.RejectionReason))
                                    {
                                        <br />
                                        <small class="text-danger">@boat.RejectionReason</small>
                                    }
                                }                            </td>
                            <td>
                                @Html.ActionLink("Edit", "EditBoat", "BoatOwner", new { id = boat.BoatID }, new { @class = "btn btn-sm btn-outline-primary" })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("Back to Dashboard", "Dashboard", "BoatOwner", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
