@{
    ViewBag.Title = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card hc-card p-4 p-md-5 text-center">
                <hgroup>
                    <h1 style="color: var(--hc-danger);">Error.</h1>
                    <h2 class="h5 mt-2" style="color: var(--hc-text-muted);">An error occurred while processing your request.</h2>
                </hgroup>
                <div class="mt-4">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Back to Home</a>
                </div>
            </div>
        </div>
    </div>
</div>
