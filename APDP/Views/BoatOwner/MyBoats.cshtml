@model IEnumerable<APDP.Models.Boat>
@{
    ViewBag.Title = "My Boats";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="hc-page-title">&#128674; My Boats</h2>
        @Html.ActionLink("+ Add New Boat", "AddBoat", "BoatOwner", null, new { @class = "btn btn-success" })
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center p-5">
            <h5>No boats registered yet.</h5>
            <p class="mb-3">Add your first boat to get started.</p>
            @Html.ActionLink("Add Your First Boat", "AddBoat", "BoatOwner", null, new { @class = "btn btn-primary" })
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover hc-table align-middle" style="min-width:900px;">
                <thead>
                    <tr>
                        <th style="white-space:nowrap;">Reg. Number</th>
                        <th style="white-space:nowrap;">Boat Name</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Price</th>
                        <th style="white-space:nowrap;">Max Pax</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var boat in Model)
                    {
                        <tr>
                            <td><span class="badge bg-dark fs-6 px-2 py-1">@boat.RegistrationNumber</span></td>
                            <td class="fw-semibold">@boat.BoatName</td>
                            <td>@boat.BoatType</td>
                            <td>@boat.HarbourLocation</td>
                            <td>R @boat.PriceAdult.ToString("N2")/hr &nbsp;|&nbsp; R @boat.PriceChild.ToString("N2")/hr</td>
                            <td>@boat.MaxPassengers</td>
                            <td>
                                @if (boat.TotalRatings > 0)
                                {
                                    <span class="text-warning">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            if (s <= Math.Round(boat.AverageRating))
                                            { <text>&#9733;</text> }
                                            else
                                            { <text>&#9734;</text> }
                                        }
                                    </span>
                                    <br /><small class="text-muted">@boat.AverageRating.ToString("0.0") (@boat.TotalRatings)</small>
                                }
                                else
                                {
                                    <small class="text-muted">No ratings yet</small>
                                }
                            </td>
                            <td>
                                @if (boat.Status == APDP.Models.BoatStatus.Active)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.AwaitingPayment)
                                {
                                    <span class="badge bg-info text-dark">Awaiting Payment</span>
                                    <br />
                                    <small class="text-info">TNPA approved - pay registration fee</small>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending Review</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Inactive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Removed)
                                {
                                    <span class="badge bg-dark">Removed by TNPA</span>
                                    if (!string.IsNullOrEmpty(boat.RejectionReason))
                                    {
                                        <br />
                                        <small class="text-muted">@boat.RejectionReason</small>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                    if (!string.IsNullOrEmpty(boat.RejectionReason))
                                    {
                                        <br />
                                        <small class="text-danger">@boat.RejectionReason</small>
                                    }
                                }
                            </td>
                            <td>
                                @if (boat.Status == APDP.Models.BoatStatus.AwaitingPayment)
                                {
                                    @Html.ActionLink("Pay Now", "PayRegistrationFee", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-success fw-semibold" })
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Active
                                      && !string.IsNullOrEmpty(boat.CertificateNumber))
                                {
                                    @Html.ActionLink("Certificate", "RegistrationCertificate", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-success" })
                                    <text> </text>
                                    @Html.ActionLink("Edit", "EditBoat", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-primary" })
                                    <text> </text>
                                    @Html.ActionLink("Availability", "ManageAvailability", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-secondary" })
                                    <text> </text>
                                    <form method="post" action="@Url.Action("ToggleActive","BoatOwner",new{id=boat.BoatID})" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                onclick="return confirm('Set this boat to Inactive? Customers will see it as unavailable.')">
                                            Set Inactive
                                        </button>
                                    </form>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Inactive)
                                {
                                    @Html.ActionLink("Edit", "EditBoat", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-primary" })
                                    <text> </text>
                                    @Html.ActionLink("Availability", "ManageAvailability", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-secondary" })
                                    <text> </text>
                                    <form method="post" action="@Url.Action("ToggleActive","BoatOwner",new{id=boat.BoatID})" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Set Active
                                        </button>
                                    </form>
                                }
                                else if (boat.Status == APDP.Models.BoatStatus.Removed)
                                {
                                    <small class="text-muted">No actions available</small>
                                }
                                else
                                {
                                    @Html.ActionLink("Edit", "EditBoat", "BoatOwner",
                                        new { id = boat.BoatID },
                                        new { @class = "btn btn-sm btn-outline-primary" })
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("Back to Dashboard", "Dashboard", "BoatOwner", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
